---
---

<div class="w-full max-w-4xl mx-auto px-2 sm:px-4 mt-3 sm:mt-4">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-3">
    
    <!-- Game Mode Picker -->
    <div class="nes-card rounded-xl p-2.5 sm:p-3 flex flex-col gap-1.5 sm:gap-2">
      <label for="select-game-mode" class="text-[9px] sm:text-[10px] font-['Press_Start_2P'] text-cyan-300 flex items-center justify-between">
        <span>GAME MODE</span>
        <span class="text-[8px] text-slate-400 font-mono">SELECT</span>
      </label>
      <select
        id="select-game-mode"
        class="w-full bg-[#050814] border border-cyan-400/30 hover:border-cyan-300 rounded-lg px-2.5 py-1.5 sm:px-3 sm:py-2 text-xs font-medium text-cyan-100 focus:outline-none focus:ring-2 focus:ring-cyan-400 transition-colors font-mono"
      >
        <option value="pve-medium" selected>🤖 VS CPU (Standard)</option>
        <option value="pve-master">⚡ VS CPU (Grandmaster)</option>
        <option value="pve-easy">🌱 VS CPU (Casual)</option>
        <option value="pvp">👥 Local 2-Player (Pass & Play)</option>
        <option value="trio">⚔️ 3-Player Free-For-All</option>
      </select>
    </div>

    <!-- Arena Layout Picker -->
    <div class="nes-card rounded-xl p-2.5 sm:p-3 flex flex-col gap-1.5 sm:gap-2">
      <label for="select-board-preset" class="text-[9px] sm:text-[10px] font-['Press_Start_2P'] text-cyan-300 flex items-center justify-between">
        <span>STAGE SELECT</span>
        <span class="text-[8px] text-slate-400 font-mono">ARENA</span>
      </label>
      <select
        id="select-board-preset"
        class="w-full bg-[#050814] border border-cyan-400/30 hover:border-cyan-300 rounded-lg px-2.5 py-1.5 sm:px-3 sm:py-2 text-xs font-medium text-cyan-100 focus:outline-none focus:ring-2 focus:ring-cyan-400 transition-colors font-mono"
      >
        <option value="classic" selected>Hexagon Classic (58 Cells)</option>
        <option value="ring">The Donut Void (Center Chasm)</option>
        <option value="hourglass">Quantum Hourglass (Bottleneck)</option>
        <option value="trio">Tri-Chamber (3 Players)</option>
      </select>
    </div>

  </div>

  <!-- Action Legend Bar -->
  <div class="mt-2.5 sm:mt-3 grid grid-cols-3 gap-1.5 sm:gap-3 py-2 px-2.5 sm:px-3 rounded-xl bg-[#04060e]/95 border border-cyan-500/25 text-[10px] sm:text-[11px] font-mono text-slate-300 text-center shadow-[0_0_15px_rgba(0,0,0,0.6)]">
    <div class="flex items-center justify-center gap-1 sm:gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#10b981] shrink-0"></span>
      <span class="truncate"><strong class="text-emerald-300 font-bold">1 STEP:</strong> CLONE</span>
    </div>
    <div class="flex items-center justify-center gap-1 sm:gap-1.5 border-x border-cyan-500/20 px-1">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-[0_0_8px_#f59e0b] shrink-0"></span>
      <span class="truncate"><strong class="text-amber-300 font-bold">2 STEPS:</strong> JUMP</span>
    </div>
    <div class="flex items-center justify-center gap-1 sm:gap-1.5">
      <span class="w-2.5 h-2.5 rounded-full bg-rose-500 shadow-[0_0_8px_#ff2d60] shrink-0"></span>
      <span class="truncate"><strong class="text-rose-400 font-bold">ADJACENT:</strong> INFECT</span>
    </div>
  </div>
</div>

---
---

<div class="w-full max-w-4xl mx-auto px-2 sm:px-4 mt-3 sm:mt-4">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 sm:gap-3">
    
    <!-- Game Mode Picker -->
    <div class="vercel-card rounded-xl p-2.5 sm:p-3 flex flex-col gap-1.5 sm:gap-2">
      <label for="select-game-mode" class="text-[10px] sm:text-xs font-mono uppercase tracking-wider text-zinc-400 flex items-center justify-between">
        <span>Game Mode</span>
        <span class="text-[9px] sm:text-[10px] text-zinc-500">AI / Local</span>
      </label>
      <select
        id="select-game-mode"
        class="w-full bg-zinc-900 border border-zinc-700/80 hover:border-zinc-500 rounded-lg px-2.5 py-1.5 sm:px-3 sm:py-2 text-xs font-medium text-white focus:outline-none focus:ring-2 focus:ring-zinc-400 transition-colors"
      >
        <option value="pve-medium" selected>🤖 VS AI (Standard)</option>
        <option value="pve-master">⚡ VS AI (Grandmaster)</option>
        <option value="pve-easy">🌱 VS AI (Casual)</option>
        <option value="pvp">👥 Local 2-Player (Pass & Play)</option>
        <option value="trio">⚔️ 3-Player Free-For-All</option>
      </select>
    </div>

    <!-- Arena Layout Picker -->
    <div class="vercel-card rounded-xl p-2.5 sm:p-3 flex flex-col gap-1.5 sm:gap-2">
      <label for="select-board-preset" class="text-[10px] sm:text-xs font-mono uppercase tracking-wider text-zinc-400 flex items-center justify-between">
        <span>Arena Layout</span>
        <span class="text-[9px] sm:text-[10px] text-zinc-500">Map Geometry</span>
      </label>
      <select
        id="select-board-preset"
        class="w-full bg-zinc-900 border border-zinc-700/80 hover:border-zinc-500 rounded-lg px-2.5 py-1.5 sm:px-3 sm:py-2 text-xs font-medium text-white focus:outline-none focus:ring-2 focus:ring-zinc-400 transition-colors"
      >
        <option value="classic" selected>Hexagon Classic (58 Cells)</option>
        <option value="ring">The Donut Void (Center Chasm)</option>
        <option value="hourglass">Quantum Hourglass (Bottleneck)</option>
        <option value="trio">Tri-Chamber (3 Players)</option>
      </select>
    </div>

  </div>

  <!-- Action Legend Bar -->
  <div class="mt-2.5 sm:mt-3 grid grid-cols-3 gap-1.5 sm:gap-3 py-2 px-2.5 sm:px-3 rounded-xl bg-zinc-950/80 border border-zinc-800/80 text-[10px] sm:text-[11px] font-mono text-zinc-400 text-center">
    <div class="flex items-center justify-center gap-1 sm:gap-1.5">
      <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
      <span class="truncate"><strong class="text-zinc-200">1:</strong> Clone</span>
    </div>
    <div class="flex items-center justify-center gap-1 sm:gap-1.5 border-x border-zinc-800/80 px-1">
      <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
      <span class="truncate"><strong class="text-zinc-200">2:</strong> Jump</span>
    </div>
    <div class="flex items-center justify-center gap-1 sm:gap-1.5">
      <span class="w-2 h-2 rounded-full bg-rose-500 shrink-0"></span>
      <span class="truncate"><strong class="text-zinc-200">Adjacency:</strong> Convert</span>
    </div>
  </div>
</div>

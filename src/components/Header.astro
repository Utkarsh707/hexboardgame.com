---
---

<header class="w-full border-b border-zinc-800/80 bg-black/75 backdrop-blur-xl sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 h-14 sm:h-16 flex items-center justify-between gap-2">
    
    <!-- Brand / Logo -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <a href="/" class="flex items-center gap-2 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400 rounded-lg p-0.5" aria-label="Online Hex Board Game Home">
        <div class="relative w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center shrink-0">
          <svg class="w-7 h-7 sm:w-8 sm:h-8 text-[#ff2d60] transition-transform duration-300 group-hover:scale-110" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
            <polygon points="50,5 90,27.5 90,72.5 50,95 10,72.5 10,27.5" fill="none" stroke="currentColor" stroke-width="8" />
            <circle cx="50" cy="50" r="22" fill="#00e5ff" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-xs sm:text-sm font-semibold tracking-tight text-white flex items-center gap-1">
            Hex <span class="hidden xs:inline">Board</span> <span class="text-zinc-500 font-normal">Game</span>
          </span>
          <span class="text-[9px] sm:text-[10px] font-mono text-zinc-500 leading-none">hexboardgame.com</span>
        </div>
      </a>
    </div>

    <!-- Quick Navigation & Modals -->
    <nav class="flex items-center gap-1 sm:gap-2 shrink-0">
      <!-- How to Play button -->
      <button
        id="btn-open-how-to-play"
        type="button"
        class="inline-flex items-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-1.5 text-xs font-medium text-zinc-300 hover:text-white bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400"
        aria-label="Open How to Play guide"
      >
        <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="hidden md:inline">Rules</span>
      </button>

      <!-- Stats Button -->
      <button
        id="btn-open-stats"
        type="button"
        class="inline-flex items-center gap-1 sm:gap-1.5 px-2 sm:px-3 py-1.5 text-xs font-medium text-zinc-300 hover:text-white bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400"
        aria-label="View Game Statistics"
      >
        <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span class="hidden md:inline">Stats</span>
      </button>

      <!-- Sound Toggle -->
      <button
        id="btn-toggle-sound"
        type="button"
        class="inline-flex items-center justify-center p-1.5 sm:p-2 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 rounded-md transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400"
        aria-label="Toggle Sound effects"
        title="Toggle Sound"
      >
        <!-- Sound On Icon -->
        <svg id="icon-sound-on" class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
        </svg>
        <!-- Sound Off Icon -->
        <svg id="icon-sound-off" class="w-3.5 h-3.5 sm:w-4 sm:h-4 hidden text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
        </svg>
      </button>

      <!-- Restart Game CTA -->
      <button
        id="btn-restart-game"
        type="button"
        class="inline-flex items-center gap-1 sm:gap-1.5 px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-black bg-white hover:bg-zinc-200 rounded-md transition-all shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white shrink-0"
        aria-label="Start New Game"
      >
        <svg class="w-3.5 h-3.5 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span class="hidden sm:inline">New Game</span>
        <span class="sm:hidden">Reset</span>
      </button>
    </nav>

  </div>
</header>

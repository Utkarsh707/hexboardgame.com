---
---

<header class="w-full border-b border-slate-800/80 bg-[#03040a]/95 shrink-0 z-40">
  <div class="max-w-6xl mx-auto px-2.5 sm:px-4 h-12 sm:h-14 flex items-center justify-between gap-2">
    
    <!-- Brand / Return to Menu -->
    <div class="flex items-center gap-2 shrink-0">
      <!-- Return to Main Menu CTA -->
      <button
        id="btn-nav-menu"
        type="button"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono font-bold text-cyan-300 hover:text-white bg-cyan-950/40 hover:bg-cyan-900/60 border border-cyan-500/40 hover:border-cyan-400 rounded-lg transition-all cursor-pointer shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-cyan-400"
        title="Return to Splash Screen / Main Menu"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Menu</span>
      </button>

      <!-- Mini Brand Title -->
      <span class="hidden md:flex items-center gap-1.5 text-xs font-semibold text-slate-300 font-['Outfit']">
        <span class="w-2 h-2 rounded-full bg-[#ff2d60]"></span>
        <span>Hexxagon Arena</span>
      </span>
    </div>

    <!-- Quick Navigation & Modals -->
    <nav class="flex items-center gap-1 sm:gap-1.5 shrink-0">
      <!-- How to Play Rules Button -->
      <button
        id="btn-open-how-to-play"
        type="button"
        class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-slate-300 hover:text-white bg-slate-900/80 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 rounded-md transition-colors cursor-pointer"
        title="Rules & How to Play"
      >
        <span>📖</span>
        <span class="hidden md:inline font-mono text-[11px]">Rules</span>
      </button>

      <!-- Strategy Guide Button -->
      <button
        id="btn-open-strategy"
        type="button"
        class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-purple-300 hover:text-white bg-slate-900/80 hover:bg-slate-800 border border-slate-800 hover:border-purple-500/40 rounded-md transition-colors cursor-pointer"
        title="Tactical Strategy Guide"
      >
        <span>⚡</span>
        <span class="hidden md:inline font-mono text-[11px]">Tactics</span>
      </button>

      <!-- Stats Button -->
      <button
        id="btn-open-stats"
        type="button"
        class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-slate-300 hover:text-white bg-slate-900/80 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 rounded-md transition-colors cursor-pointer"
        title="Combat Statistics"
      >
        <span>📊</span>
        <span class="hidden md:inline font-mono text-[11px]">Stats</span>
      </button>

      <!-- Settings Button -->
      <button
        id="btn-open-settings"
        type="button"
        class="inline-flex items-center gap-1 px-2 py-1 text-xs font-medium text-slate-300 hover:text-white bg-slate-900/80 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 rounded-md transition-colors cursor-pointer"
        title="Settings & Preferences"
      >
        <span>⚙️</span>
      </button>

      <!-- Sound Toggle -->
      <button
        id="btn-toggle-sound"
        type="button"
        class="inline-flex items-center justify-center p-1.5 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 rounded-md transition-colors cursor-pointer"
        title="Toggle Sound"
      >
        <!-- Sound On Icon -->
        <svg id="icon-sound-on" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
        </svg>
        <!-- Sound Off Icon -->
        <svg id="icon-sound-off" class="w-3.5 h-3.5 hidden text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
        </svg>
      </button>

      <!-- Restart Game CTA -->
      <button
        id="btn-restart-game"
        type="button"
        class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-bold text-black bg-white hover:bg-slate-200 rounded-md transition-all shadow-sm cursor-pointer shrink-0"
        title="Reset Current Match"
      >
        <svg class="w-3.5 h-3.5 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Reset</span>
      </button>
    </nav>

  </div>
</header>

---
---

<!-- ==========================================================================
     MODERN CASUAL GAME TITLE & MATCH SETUP SCREENS (Poki.com Style)
     1. Screen Title: Clean, uncluttered landing with chunky 3D "PLAY NOW!" button
     2. Screen Setup: Playful, intuitive game mode & arena configuration
     ========================================================================== -->

<!-- SCREEN 1: CLEAN LANDING SCREEN -->
<div id="screen-title" class="screen-view w-full h-full flex flex-col items-center justify-between px-3 py-2 sm:py-5 overflow-y-auto min-h-0 select-none z-30">
  
  <!-- Top Bar (Game Badge & Audio Quick Toggle) -->
  <div class="w-full max-w-2xl flex items-center justify-between px-1 pt-1 shrink-0">
    <div class="inline-flex items-center gap-1.5 sm:gap-2 px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-full bg-[#141d38]/90 border border-cyan-400/30 text-[10px] sm:text-xs font-mono font-bold text-cyan-300 shadow-md">
      <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
      <span class="hidden xs:inline">HEXXAGON • COSMIC ARENA</span>
      <span class="xs:hidden">HEXXAGON</span>
    </div>

    <!-- Quick Audio Mute Toggle -->
    <button
      id="btn-splash-sound"
      type="button"
      class="inline-flex items-center gap-1.5 px-3 py-1 sm:py-1.5 text-xs font-mono font-bold text-slate-200 hover:text-white bg-[#141d38] hover:bg-[#1e2b50] border border-slate-700 hover:border-cyan-400 rounded-full transition-all cursor-pointer shadow-md active:scale-95 shrink-0"
      title="Toggle Audio"
    >
      <span id="splash-sound-icon">🔊</span>
      <span id="splash-sound-text" class="hidden xs:inline">AUDIO ON</span>
    </button>
  </div>

  <!-- Center Hero Section -->
  <div class="w-full max-w-xl flex flex-col items-center justify-center gap-3 sm:gap-6 my-auto px-2 py-2">
    
    <!-- 3D Gems Duel Emblem & Title -->
    <div class="flex flex-col items-center text-center">
      <!-- Floating Gems Emblem -->
      <div class="relative w-20 h-16 sm:w-28 sm:h-24 flex items-center justify-center hero-emblem-container">
        <!-- Ruby Gem Sphere -->
        <div class="absolute -left-2 sm:-left-2 w-12 h-12 sm:w-18 sm:h-18 rounded-full shadow-[0_8px_30px_rgba(255,45,96,0.6)] transition-transform hover:scale-110 hero-emblem-gem">
          <svg viewBox="0 0 100 100" class="w-full h-full">
            <ellipse cx="50" cy="85" rx="40" ry="12" fill="rgba(0,0,0,0.4)"></ellipse>
            <circle cx="50" cy="48" r="44" fill="url(#title-ruby)" stroke="rgba(255,255,255,0.4)" stroke-width="2"></circle>
            <ellipse cx="36" cy="34" rx="18" ry="10" transform="rotate(-28 36 34)" fill="rgba(255,255,255,0.8)"></ellipse>
            <circle cx="30" cy="28" r="5" fill="#ffffff"></circle>
            <defs>
              <radialGradient id="title-ruby" cx="30%" cy="26%" r="72%">
                <stop offset="0%" stop-color="#ff7b96"/>
                <stop offset="22%" stop-color="#ff0844"/>
                <stop offset="60%" stop-color="#ba002c"/>
                <stop offset="100%" stop-color="#240008"/>
              </radialGradient>
            </defs>
          </svg>
        </div>

        <!-- Pearl Gem Sphere -->
        <div class="absolute -right-2 sm:-right-2 w-12 h-12 sm:w-18 sm:h-18 rounded-full shadow-[0_8px_30px_rgba(0,229,255,0.6)] transition-transform hover:scale-110 hero-emblem-gem">
          <svg viewBox="0 0 100 100" class="w-full h-full">
            <ellipse cx="50" cy="85" rx="40" ry="12" fill="rgba(0,0,0,0.4)"></ellipse>
            <circle cx="50" cy="48" r="44" fill="url(#title-pearl)" stroke="rgba(255,255,255,0.5)" stroke-width="2"></circle>
            <ellipse cx="36" cy="34" rx="18" ry="10" transform="rotate(-28 36 34)" fill="rgba(255,255,255,0.9)"></ellipse>
            <circle cx="30" cy="28" r="5" fill="#ffffff"></circle>
            <defs>
              <radialGradient id="title-pearl" cx="30%" cy="26%" r="72%">
                <stop offset="0%" stop-color="#ffffff"/>
                <stop offset="25%" stop-color="#e0f2fe"/>
                <stop offset="60%" stop-color="#7dd3fc"/>
                <stop offset="85%" stop-color="#0284c7"/>
                <stop offset="100%" stop-color="#082f49"/>
              </radialGradient>
            </defs>
          </svg>
        </div>

        <!-- Center Hex Shield -->
        <div class="relative z-10 w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center">
          <svg viewBox="0 0 100 100" class="w-full h-full filter drop-shadow-[0_4px_12px_rgba(56,189,248,0.8)]">
            <polygon points="50,5 90,27.5 90,72.5 50,95 10,72.5 10,27.5" fill="#0d1429" stroke="#38bdf8" stroke-width="6" />
            <polygon points="50,20 80,37 80,63 50,80 20,63 20,37" fill="#38bdf8" opacity="0.4" />
          </svg>
        </div>
      </div>

      <!-- Main Logo Title -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-black tracking-tight text-white font-['Outfit'] mt-2 sm:mt-3 flex items-center justify-center gap-2 hero-title-text drop-shadow-md">
        <span class="bg-gradient-to-r from-white via-slate-100 to-slate-200 bg-clip-text text-transparent">HEX</span>
        <span class="text-[#ff2d60] drop-shadow-[0_0_24px_rgba(255,45,96,0.6)]">BOARD</span>
      </h1>
      <p class="text-[11px] sm:text-sm font-bold font-['Outfit'] text-cyan-300 tracking-wide uppercase mt-0.5 sm:mt-1">
        Turn-Based Gem Conquest
      </p>
    </div>

    <!-- PROMINENT POKI 3D "PLAY NOW!" & "TUTORIAL" BUTTONS -->
    <div class="flex flex-col sm:flex-row items-center gap-2.5 sm:gap-4 w-full justify-center">
      <button
        id="btn-title-play"
        type="button"
        class="poki-btn poki-btn-primary btn-hero-play w-full sm:w-auto px-8 sm:px-14 py-3.5 sm:py-4 rounded-2xl text-base sm:text-xl font-black uppercase flex items-center justify-center gap-2.5"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#0b0f19]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <span>PLAY NOW!</span>
      </button>

      <button
        id="btn-title-tutorial"
        type="button"
        class="poki-btn poki-btn-cyan w-full sm:w-auto px-6 sm:px-9 py-3 sm:py-4 rounded-2xl text-sm sm:text-lg font-black uppercase flex items-center justify-center gap-2"
      >
        <span class="text-base sm:text-lg">🎓</span>
        <span>TUTORIAL</span>
      </button>
    </div>

  </div>

  <!-- Bottom Utility Navigation Bar (Neat Wrapping Pills) -->
  <div class="w-full max-w-xl flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 pt-1 pb-1 shrink-0">
    <button id="btn-splash-tutorial" type="button" class="poki-btn poki-btn-secondary px-3 py-1 text-[11px] sm:text-xs font-mono font-bold text-cyan-300 hover:text-white rounded-xl">
      <span>🎓 Tutorial</span>
    </button>

    <button id="btn-splash-how-to-play" type="button" class="poki-btn poki-btn-secondary px-3 py-1 text-[11px] sm:text-xs font-mono font-bold text-slate-300 hover:text-white rounded-xl">
      <span>📖 Rules</span>
    </button>

    <button id="btn-splash-strategy" type="button" class="poki-btn poki-btn-secondary px-3 py-1 text-[11px] sm:text-xs font-mono font-bold text-purple-300 hover:text-white rounded-xl">
      <span>⚡ Tactics</span>
    </button>

    <button id="btn-splash-stats" type="button" class="poki-btn poki-btn-secondary px-3 py-1 text-[11px] sm:text-xs font-mono font-bold text-slate-300 hover:text-white rounded-xl">
      <span>📊 Stats</span>
    </button>

    <button id="btn-splash-settings" type="button" class="poki-btn poki-btn-secondary px-3 py-1 text-[11px] sm:text-xs font-mono font-bold text-slate-300 hover:text-white rounded-xl">
      <span>⚙️ Settings</span>
    </button>

    <button id="btn-splash-shortcuts" type="button" class="poki-btn poki-btn-secondary px-3 py-1 text-[11px] sm:text-xs font-mono font-bold text-slate-300 hover:text-white rounded-xl">
      <span>⌨️ Controls</span>
    </button>

    <button id="btn-splash-about" type="button" class="poki-btn poki-btn-secondary px-3 py-1 text-[11px] sm:text-xs font-mono font-bold text-slate-300 hover:text-white rounded-xl">
      <span>ℹ️ About</span>
    </button>
  </div>

</div>


<!-- SCREEN 2: MATCH SETUP & ARENA SELECT SCREEN -->
<div id="screen-setup" class="screen-view hidden-screen w-full h-full flex flex-col items-center justify-between px-3 py-2 sm:py-5 overflow-y-auto min-h-0 select-none z-30">
  
  <!-- Setup Header with Back Button -->
  <div class="w-full max-w-xl flex items-center justify-between px-1 pt-1 shrink-0">
    <button
      id="btn-setup-back"
      type="button"
      class="poki-btn poki-btn-secondary px-3 py-1 text-xs font-mono font-bold text-slate-200 hover:text-white rounded-full flex items-center gap-1.5"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span>BACK</span>
    </button>

    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#141d38] border border-slate-700 text-xs font-mono font-bold text-cyan-400">
      <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
      <span>MATCH SETUP</span>
    </div>
  </div>

  <!-- Match Configuration Card -->
  <div class="w-full max-w-xl flex flex-col items-center justify-center my-auto py-2">
    <div class="w-full poki-card rounded-3xl p-3.5 sm:p-6 border border-slate-700/60 flex flex-col gap-3 sm:gap-4 shadow-2xl">
      
      <!-- Section Title -->
      <div class="flex items-center justify-between border-b border-slate-700/60 pb-2.5">
        <div>
          <h2 class="text-base sm:text-xl font-black text-white font-['Outfit'] tracking-wide">
            Game Setup
          </h2>
          <p class="text-[11px] sm:text-xs font-medium text-slate-300">Choose game mode, arena layout, and difficulty.</p>
        </div>
        <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-2xl bg-cyan-500/10 border border-cyan-400/40 flex items-center justify-center shrink-0 shadow-sm">
          <span class="text-base sm:text-lg">🎮</span>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3">
        <!-- Game Mode Selection -->
        <div class="flex flex-col gap-1">
          <label for="splash-select-mode" class="text-[11px] sm:text-xs font-bold text-slate-300 font-['Outfit'] uppercase tracking-wider">
            Game Mode
          </label>
          <select
            id="splash-select-mode"
            class="w-full bg-[#0d1429] border-2 border-slate-700 hover:border-cyan-400 rounded-xl px-3 py-2 text-xs font-bold text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-400 transition-colors font-mono cursor-pointer"
          >
            <option value="pve" selected>🤖 VS Bot (1 Player)</option>
            <option value="pvp">👥 Pass & Play (2 Players)</option>
            <option value="trio">⚡ 3-Player Free-For-All</option>
            <option value="tutorial">🎓 Tutorial (Learn to Play)</option>
          </select>
        </div>

        <!-- Maze Type Selection -->
        <div class="flex flex-col gap-1">
          <label for="splash-select-preset" class="text-[11px] sm:text-xs font-bold text-slate-300 font-['Outfit'] uppercase tracking-wider">
            Arena Layout
          </label>
          <select
            id="splash-select-preset"
            class="w-full bg-[#0d1429] border-2 border-slate-700 hover:border-cyan-400 rounded-xl px-3 py-2 text-xs font-bold text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-400 transition-colors font-mono cursor-pointer"
          >
            <option value="classic" selected>Classic Arena (58 Cells)</option>
            <option value="ring">Donut Void (48 Cells)</option>
            <option value="hourglass">Hourglass (40 Cells)</option>
            <option value="trio">Tri-Chamber (61 Cells)</option>
            <option value="warp">Warp Nexus (84 Cells)</option>
          </select>
        </div>
      </div>

      <!-- Theme / Stage Select -->
      <div class="flex flex-col gap-1.5">
        <div class="flex items-center justify-between">
          <span class="text-[11px] sm:text-xs font-bold text-slate-300 font-['Outfit'] uppercase tracking-wider">
            Board Theme
          </span>
          <span id="splash-theme-tagline" class="text-[10px] sm:text-xs font-mono font-bold text-cyan-300">
            Cosmic Ruby & Pearl
          </span>
        </div>

        <select id="splash-select-theme" class="hidden">
          <option value="space_invaders" selected>Cosmic Ruby & Pearl</option>
          <option value="kirby_mario">Sunset Horizon</option>
          <option value="cyberpunk">Cyber Neon</option>
          <option value="tetris">Ocean Depths</option>
        </select>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5 sm:gap-2">
          <!-- Theme 1: Cosmic -->
          <button
            type="button"
            data-theme="space_invaders"
            class="btn-splash-theme active theme-select-card p-2 sm:p-2.5 rounded-2xl border-2 border-cyan-400 bg-cyan-500/20 text-left flex flex-col gap-1 cursor-pointer transition-all active:scale-95"
          >
            <div class="flex items-center justify-between w-full">
              <span class="text-sm sm:text-base">💎</span>
              <span class="text-[9px] font-mono px-1.5 py-0.5 rounded-full bg-cyan-400/20 text-cyan-300 font-bold">Classic</span>
            </div>
            <div>
              <div class="text-[11px] sm:text-xs font-black text-white font-['Outfit'] truncate">Cosmic Arena</div>
              <div class="text-[9px] sm:text-[10px] font-mono text-slate-300 truncate">Ruby & Pearl</div>
            </div>
          </button>

          <!-- Theme 2: Sunset -->
          <button
            type="button"
            data-theme="kirby_mario"
            class="btn-splash-theme theme-select-card p-2 sm:p-2.5 rounded-2xl border-2 border-slate-700 bg-[#0d1429] text-left flex flex-col gap-1 cursor-pointer transition-all hover:border-pink-400 active:scale-95"
          >
            <div class="flex items-center justify-between w-full">
              <span class="text-sm sm:text-base">🌅</span>
              <span class="text-[9px] font-mono px-1.5 py-0.5 rounded-full bg-pink-500/20 text-pink-300 font-bold">Sunset</span>
            </div>
            <div>
              <div class="text-[11px] sm:text-xs font-black text-white font-['Outfit'] truncate">Sunset Horizon</div>
              <div class="text-[9px] sm:text-[10px] font-mono text-slate-300 truncate">Warm Glow</div>
            </div>
          </button>

          <!-- Theme 3: Cyber -->
          <button
            type="button"
            data-theme="cyberpunk"
            class="btn-splash-theme theme-select-card p-2 sm:p-2.5 rounded-2xl border-2 border-slate-700 bg-[#0d1429] text-left flex flex-col gap-1 cursor-pointer transition-all hover:border-purple-400 active:scale-95"
          >
            <div class="flex items-center justify-between w-full">
              <span class="text-sm sm:text-base">⚡</span>
              <span class="text-[9px] font-mono px-1.5 py-0.5 rounded-full bg-purple-500/20 text-purple-300 font-bold">Neon</span>
            </div>
            <div>
              <div class="text-[11px] sm:text-xs font-black text-white font-['Outfit'] truncate">Cyber Neon</div>
              <div class="text-[9px] sm:text-[10px] font-mono text-slate-300 truncate">Electric Synth</div>
            </div>
          </button>

          <!-- Theme 4: Ocean -->
          <button
            type="button"
            data-theme="tetris"
            class="btn-splash-theme theme-select-card p-2 sm:p-2.5 rounded-2xl border-2 border-slate-700 bg-[#0d1429] text-left flex flex-col gap-1 cursor-pointer transition-all hover:border-blue-400 active:scale-95"
          >
            <div class="flex items-center justify-between w-full">
              <span class="text-sm sm:text-base">🌊</span>
              <span class="text-[9px] font-mono px-1.5 py-0.5 rounded-full bg-blue-500/20 text-blue-300 font-bold">Ocean</span>
            </div>
            <div>
              <div class="text-[11px] sm:text-xs font-black text-white font-['Outfit'] truncate">Ocean Depths</div>
              <div class="text-[9px] sm:text-[10px] font-mono text-slate-300 truncate">Deep Azure</div>
            </div>
          </button>
        </div>
      </div>

      <!-- CPU Difficulty (Visible in PvE mode) -->
      <div id="splash-container-difficulty" class="flex flex-col gap-1">
        <span class="text-[11px] sm:text-xs font-bold text-slate-300 font-['Outfit'] uppercase tracking-wider">
          AI Difficulty
        </span>
        <div class="grid grid-cols-3 gap-1.5 p-1 rounded-2xl bg-[#0d1429] border border-slate-700">
          <button type="button" data-diff="easy" class="btn-splash-diff py-1.5 sm:py-2 text-xs font-mono font-bold text-slate-400 rounded-xl transition-colors hover:text-emerald-300 cursor-pointer active:scale-95">Easy</button>
          <button type="button" data-diff="medium" class="btn-splash-diff active py-1.5 sm:py-2 text-xs font-mono font-bold text-cyan-200 bg-cyan-500/20 border border-cyan-400/80 rounded-xl cursor-pointer active:scale-95">Medium</button>
          <button type="button" data-diff="master" class="btn-splash-diff py-1.5 sm:py-2 text-xs font-mono font-bold text-slate-400 rounded-xl transition-colors hover:text-rose-400 cursor-pointer active:scale-95">Master</button>
        </div>
      </div>

      <!-- START BATTLE CTA BUTTON -->
      <button
        id="btn-splash-start-game"
        type="button"
        class="poki-btn poki-btn-primary w-full mt-1 sm:mt-2 py-3.5 sm:py-4 px-6 rounded-2xl text-base sm:text-lg font-black tracking-wide uppercase flex items-center justify-center gap-2 shadow-xl"
      >
        <svg class="w-5 h-5 text-[#0b0f19]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <span>START BATTLE</span>
      </button>

    </div>
  </div>

  <!-- Bottom Spacer -->
  <div class="h-1 sm:h-2 shrink-0"></div>

</div>

---
---

<!-- ==========================================================================
     8-BIT RETRO FREE-FLOATING LANDING & MATCH SETUP SYSTEM
     - Authentic 8-bit arcade typography (Press Start 2P)
     - Screen 1: Minimal bouncy play button + bottom-right mute
     - Screen 2: Free-floating 1P vs 2P & difficulty selector
     ========================================================================== -->

<!-- SCREEN 1: MINIMAL BOUNCY PLAY LANDING -->
<div id="screen-title" class="screen-view w-full h-full flex flex-col items-center justify-center p-4 select-none z-30 relative overflow-hidden">
  
  <!-- CENTER HERO: Bouncy Play (Triangle) Button -->
  <div class="flex flex-col items-center justify-center gap-4 my-auto">
    <button
      id="btn-title-play"
      type="button"
      class="bouncy-play-btn group relative w-24 h-24 sm:w-32 sm:h-32 md:w-36 md:h-36 rounded-full flex items-center justify-center focus:outline-none cursor-pointer transition-transform"
      aria-label="Start Hex Board Game"
      title="Play Game"
    >
      <!-- Multi-Layer Radial Glow Aura -->
      <div class="absolute -inset-3 rounded-full bg-gradient-to-r from-[#ff2d60] via-[#8b5cf6] to-[#00e5ff] opacity-75 blur-xl group-hover:opacity-100 transition-opacity animate-pulse"></div>

      <!-- Outer 3D Beveled Ring -->
      <div class="absolute inset-0 rounded-full bg-gradient-to-b from-white/30 to-black/50 p-1">
        <!-- Inner Core Button Surface -->
        <div class="w-full h-full rounded-full bg-gradient-to-br from-[#ff2d60] via-[#e11d48] to-[#9f1239] shadow-[inset_0_2px_4px_rgba(255,255,255,0.6),0_12px_32px_rgba(255,45,96,0.6)] flex items-center justify-center transition-all group-hover:scale-105 group-active:scale-95">
          <!-- Play Triangle SVG -->
          <svg
            class="w-10 h-10 sm:w-14 sm:h-14 md:w-16 md:h-16 text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)] ml-1.5 sm:ml-2.5 transition-transform group-hover:scale-110"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path d="M8 5.14v13.72a1 1 0 001.5.86l11.54-6.86a1 1 0 000-1.72L9.5 4.28a1 1 0 00-1.5.86z"/>
          </svg>
        </div>
      </div>
    </button>
  </div>

  <!-- BOTTOM-RIGHT CORNER: Audio Mute / Unmute Button -->
  <div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 z-40">
    <button
      id="btn-splash-sound"
      type="button"
      class="w-11 h-11 sm:w-13 sm:h-13 rounded-full bg-[#0b1226]/85 hover:bg-[#141f3d] border border-cyan-500/40 hover:border-cyan-400 text-cyan-300 hover:text-white shadow-lg backdrop-blur-md flex items-center justify-center text-lg sm:text-xl transition-all active:scale-95 cursor-pointer"
      title="Toggle Audio"
      aria-label="Toggle Sound"
    >
      <span id="splash-sound-icon">🔊</span>
    </button>
  </div>

</div>


<!-- SCREEN 2: FREE-FLOATING 8-BIT MATCH CONFIGURATION -->
<div id="screen-setup" class="screen-view hidden-screen w-full h-full flex flex-col items-center justify-between p-4 sm:p-8 select-none z-30 relative overflow-hidden">
  
  <!-- Top Bar: Floating Back Button -->
  <div class="w-full max-w-2xl flex items-center justify-between pt-2 shrink-0">
    <button
      id="btn-setup-back"
      type="button"
      class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/15 border border-white/10 hover:border-cyan-400 text-[9px] sm:text-[10px] text-slate-300 hover:text-white backdrop-blur-md transition-all active:scale-95 cursor-pointer font-['Press_Start_2P']"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span>BACK</span>
    </button>

    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-xl bg-white/5 border border-white/10 text-[9px] sm:text-[10px] text-cyan-400 backdrop-blur-md font-['Press_Start_2P']">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
      <span>SETUP</span>
    </div>
  </div>

  <!-- Center: Free-Floating Interactive Setup Cluster -->
  <div class="flex flex-col items-center justify-center gap-5 sm:gap-7 my-auto max-w-lg w-full text-center">
    
    <!-- Floating Mode Selection -->
    <div class="flex flex-col items-center gap-2.5 w-full">
      <span class="text-[9px] sm:text-[10px] text-cyan-300/80 uppercase font-['Press_Start_2P'] leading-relaxed">
        SELECT MODE
      </span>

      <div class="grid grid-cols-2 gap-3 sm:gap-4 w-full">
        <!-- 1 Player Option -->
        <button
          id="btn-mode-pve"
          type="button"
          data-mode="pve"
          class="mode-pill active group relative px-3 py-3 sm:py-4 rounded-2xl border-2 border-cyan-400 bg-cyan-500/15 shadow-[0_0_20px_rgba(0,229,255,0.25)] flex flex-col items-center gap-2 transition-all active:scale-95 cursor-pointer font-['Press_Start_2P']"
        >
          <span class="text-2xl sm:text-3xl group-hover:scale-110 transition-transform">🤖</span>
          <span class="text-[10px] sm:text-xs text-white uppercase leading-snug">1 PLAYER</span>
          <span class="text-[8px] sm:text-[9px] text-cyan-300/90 leading-tight">VS BOT</span>
        </button>

        <!-- 2 Players Option -->
        <button
          id="btn-mode-pvp"
          type="button"
          data-mode="pvp"
          class="mode-pill group relative px-3 py-3 sm:py-4 rounded-2xl border-2 border-white/15 bg-white/5 hover:border-pink-400/80 hover:bg-pink-500/10 flex flex-col items-center gap-2 transition-all active:scale-95 cursor-pointer font-['Press_Start_2P']"
        >
          <span class="text-2xl sm:text-3xl group-hover:scale-110 transition-transform">👥</span>
          <span class="text-[10px] sm:text-xs text-white uppercase leading-snug">2 PLAYER</span>
          <span class="text-[8px] sm:text-[9px] text-slate-400 leading-tight">HOTSEAT</span>
        </button>
      </div>
    </div>

    <!-- Floating Difficulty Selection (Visible in 1P mode) -->
    <div id="setup-difficulty-group" class="flex flex-col items-center gap-2 w-full transition-all duration-300">
      <span class="text-[9px] sm:text-[10px] text-slate-400 uppercase font-['Press_Start_2P'] leading-relaxed">
        BOT DIFFICULTY
      </span>

      <div class="grid grid-cols-3 gap-2 sm:gap-2.5 w-full max-w-sm">
        <button
          type="button"
          data-diff="easy"
          class="btn-floating-diff px-2.5 py-2.5 rounded-xl border border-white/10 bg-white/5 hover:border-emerald-400 hover:text-emerald-300 text-[9px] sm:text-[10px] text-slate-400 transition-all active:scale-95 cursor-pointer font-['Press_Start_2P']"
        >
          EASY
        </button>

        <button
          type="button"
          data-diff="medium"
          class="btn-floating-diff active px-2.5 py-2.5 rounded-xl border-2 border-cyan-400 bg-cyan-500/20 text-cyan-200 shadow-[0_0_12px_rgba(0,229,255,0.3)] text-[9px] sm:text-[10px] transition-all active:scale-95 cursor-pointer font-['Press_Start_2P']"
        >
          MED
        </button>

        <button
          type="button"
          data-diff="master"
          class="btn-floating-diff px-2.5 py-2.5 rounded-xl border border-white/10 bg-white/5 hover:border-rose-400 hover:text-rose-300 text-[9px] sm:text-[10px] text-slate-400 transition-all active:scale-95 cursor-pointer font-['Press_Start_2P']"
        >
          HARD
        </button>
      </div>
    </div>

    <!-- Free-Floating 8-Bit Start Button -->
    <div class="pt-2 sm:pt-3 w-full flex justify-center">
      <button
        id="btn-setup-start-game"
        type="button"
        class="bouncy-play-btn group relative px-7 sm:px-10 py-3.5 sm:py-4 rounded-2xl bg-gradient-to-r from-[#ff2d60] via-[#e11d48] to-[#00e5ff] text-white text-[11px] sm:text-xs font-['Press_Start_2P'] uppercase flex items-center justify-center gap-2.5 shadow-[0_8px_32px_rgba(255,45,96,0.5)] transition-all hover:scale-105 active:scale-95 cursor-pointer"
      >
        <svg class="w-4 h-4 text-white fill-current" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <span>START</span>
      </button>
    </div>

  </div>

  <!-- Bottom Bar: Spacer & Sound Toggle Sync -->
  <div class="w-full max-w-2xl flex items-center justify-end pb-2 shrink-0">
    <button
      id="btn-setup-sound"
      type="button"
      class="w-10 h-10 rounded-full bg-white/5 hover:bg-white/15 border border-white/10 hover:border-cyan-400 text-cyan-300 hover:text-white shadow-md backdrop-blur-md flex items-center justify-center text-base transition-all active:scale-95 cursor-pointer"
      title="Toggle Audio"
    >
      <span id="setup-sound-icon">🔊</span>
    </button>
  </div>

</div>

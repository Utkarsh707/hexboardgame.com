---
---

<!-- ==========================================================================
     HEXXAGON TITLE & SETUP SCREENS
     1. Screen Title: Clean, uncluttered landing with animated "PLAY!" button
     2. Screen Setup: Match configuration options (Mode, Arena, Difficulty)
     ========================================================================== -->

<!-- SCREEN 1: CLEAN LANDING SCREEN (Zero Option Overload) -->
<div id="screen-title" class="screen-view w-full h-full flex flex-col items-center justify-between px-3 py-3 sm:py-6 overflow-hidden select-none z-30">
  
  <!-- Top Bar (Version Badge & Audio Quick Toggle) -->
  <div class="w-full max-w-3xl flex items-center justify-between px-1 sm:px-2 pt-1 sm:pt-0">
    <div class="inline-flex items-center gap-1.5 sm:gap-2 px-2.5 sm:px-3 py-1 rounded-full bg-[#050814]/90 border border-cyan-500/30 text-[9px] sm:text-[10px] font-mono text-cyan-300 shadow-[0_0_12px_rgba(0,229,255,0.2)]">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
      <span class="truncate">HEXXAGON COSMIC ARENA</span>
    </div>

    <!-- Quick Audio Mute Toggle -->
    <button
      id="btn-splash-sound"
      type="button"
      class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1 text-xs font-mono font-medium text-slate-300 hover:text-white bg-[#050814]/90 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 rounded-full transition-all cursor-pointer shadow-sm active:scale-95"
      title="Toggle Audio"
    >
      <span id="splash-sound-icon">🔊</span>
      <span id="splash-sound-text" class="hidden xs:inline">AUDIO ON</span>
    </button>
  </div>

  <!-- Center Hero Section -->
  <div class="w-full max-w-xl flex flex-col items-center justify-center gap-4 sm:gap-7 my-auto px-2">
    
    <!-- 3D Gems Duel Emblem & Title -->
    <div class="flex flex-col items-center text-center">
      <!-- Floating Gems Emblem -->
      <div class="relative w-20 h-16 sm:w-28 sm:h-24 flex items-center justify-center hero-emblem-container">
        <!-- Ruby Gem Sphere -->
        <div class="absolute -left-2 sm:left-0 w-11 h-11 sm:w-16 sm:h-16 rounded-full shadow-[0_0_30px_rgba(255,8,68,0.6)] transition-transform hover:scale-110 hero-emblem-gem">
          <svg viewBox="0 0 100 100" class="w-full h-full">
            <ellipse cx="50" cy="85" rx="40" ry="12" fill="rgba(0,0,0,0.5)"></ellipse>
            <circle cx="50" cy="48" r="44" fill="url(#title-ruby)" stroke="rgba(255,255,255,0.4)" stroke-width="2"></circle>
            <ellipse cx="36" cy="34" rx="18" ry="10" transform="rotate(-28 36 34)" fill="rgba(255,255,255,0.75)"></ellipse>
            <circle cx="30" cy="28" r="5" fill="#ffffff"></circle>
            <defs>
              <radialGradient id="title-ruby" cx="30%" cy="26%" r="72%">
                <stop offset="0%" stop-color="#ff7b96"/>
                <stop offset="22%" stop-color="#ff0844"/>
                <stop offset="60%" stop-color="#ba002c"/>
                <stop offset="100%" stop-color="#240008"/>
              </radialGradient>
            </defs>
          </svg>
        </div>

        <!-- Pearl Gem Sphere -->
        <div class="absolute -right-2 sm:right-0 w-11 h-11 sm:w-16 sm:h-16 rounded-full shadow-[0_0_30px_rgba(0,229,255,0.6)] transition-transform hover:scale-110 hero-emblem-gem">
          <svg viewBox="0 0 100 100" class="w-full h-full">
            <ellipse cx="50" cy="85" rx="40" ry="12" fill="rgba(0,0,0,0.5)"></ellipse>
            <circle cx="50" cy="48" r="44" fill="url(#title-pearl)" stroke="rgba(255,255,255,0.5)" stroke-width="2"></circle>
            <ellipse cx="36" cy="34" rx="18" ry="10" transform="rotate(-28 36 34)" fill="rgba(255,255,255,0.85)"></ellipse>
            <circle cx="30" cy="28" r="5" fill="#ffffff"></circle>
            <defs>
              <radialGradient id="title-pearl" cx="30%" cy="26%" r="72%">
                <stop offset="0%" stop-color="#ffffff"/>
                <stop offset="25%" stop-color="#f2f7fc"/>
                <stop offset="60%" stop-color="#c5d1d9"/>
                <stop offset="85%" stop-color="#607d8b"/>
                <stop offset="100%" stop-color="#263238"/>
              </radialGradient>
            </defs>
          </svg>
        </div>

        <!-- Center Hex Shield -->
        <div class="relative z-10 w-7 h-7 sm:w-9 sm:h-9 flex items-center justify-center">
          <svg viewBox="0 0 100 100" class="w-full h-full filter drop-shadow-[0_0_10px_rgba(56,189,248,0.9)]">
            <polygon points="50,5 90,27.5 90,72.5 50,95 10,72.5 10,27.5" fill="#04060c" stroke="#38bdf8" stroke-width="6" />
            <polygon points="50,20 80,37 80,63 50,80 20,63 20,37" fill="#38bdf8" opacity="0.35" />
          </svg>
        </div>
      </div>

      <!-- Main Logo Title -->
      <h1 class="text-2xl sm:text-4xl md:text-5xl font-black tracking-tight text-white font-['Outfit'] mt-2 flex items-center justify-center gap-2 hero-title-text">
        <span class="bg-gradient-to-r from-white via-slate-100 to-slate-300 bg-clip-text text-transparent">HEX BOARD</span>
        <span class="text-[#ff2d60] drop-shadow-[0_0_20px_rgba(255,45,96,0.6)]">GAME</span>
      </h1>
      <p class="text-[11px] sm:text-sm font-mono text-cyan-300/80 tracking-wider sm:tracking-widest uppercase mt-1">
        Hexxagon Turn-Based Strategy
      </p>
    </div>

    <!-- PROMINENT ANIMATED "PLAY!" ACTION BUTTON -->
    <button
      id="btn-title-play"
      type="button"
      class="btn-hero-play hero-btn-play px-8 sm:px-14 py-3.5 sm:py-5 rounded-2xl bg-[#ffd000] hover:bg-[#ffe033] text-[#050814] font-black font-['Outfit'] text-lg sm:text-2xl tracking-wider uppercase flex items-center justify-center gap-2.5 sm:gap-3 cursor-pointer select-none border-2 border-[#fff37a] shadow-[0_4px_25px_rgba(255,208,0,0.5)]"
    >
      <svg class="w-5 h-5 sm:w-7 sm:h-7 text-[#050814] transition-transform group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
      <span>PLAY!</span>
    </button>

  </div>

  <!-- Bottom Utility Navigation Bar -->
  <div class="w-full max-w-xl flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 pt-1 pb-1">
    <button id="btn-splash-how-to-play" type="button" class="inline-flex items-center gap-1 sm:gap-1.5 px-2.5 sm:px-3 py-1.5 text-xs font-semibold font-mono text-slate-300 hover:text-white bg-[#070b16]/90 hover:bg-slate-800 border border-slate-800 hover:border-cyan-400/50 rounded-xl transition-all cursor-pointer active:scale-95">
      <span>📖</span>
      <span>Rules</span>
    </button>

    <button id="btn-splash-strategy" type="button" class="inline-flex items-center gap-1 sm:gap-1.5 px-2.5 sm:px-3 py-1.5 text-xs font-semibold font-mono text-purple-300 hover:text-white bg-[#070b16]/90 hover:bg-slate-800 border border-slate-800 hover:border-purple-400/50 rounded-xl transition-all cursor-pointer active:scale-95">
      <span>⚡</span>
      <span>Strategy</span>
    </button>

    <button id="btn-splash-settings" type="button" class="inline-flex items-center gap-1 sm:gap-1.5 px-2.5 sm:px-3 py-1.5 text-xs font-semibold font-mono text-slate-300 hover:text-white bg-[#070b16]/90 hover:bg-slate-800 border border-slate-800 hover:border-cyan-400/50 rounded-xl transition-all cursor-pointer active:scale-95">
      <span>⚙️</span>
      <span>Settings</span>
    </button>

    <button id="btn-splash-stats" type="button" class="inline-flex items-center gap-1 sm:gap-1.5 px-2.5 sm:px-3 py-1.5 text-xs font-semibold font-mono text-slate-300 hover:text-white bg-[#070b16]/90 hover:bg-slate-800 border border-slate-800 hover:border-cyan-400/50 rounded-xl transition-all cursor-pointer active:scale-95">
      <span>📊</span>
      <span>Stats</span>
    </button>

    <button id="btn-splash-shortcuts" type="button" class="inline-flex items-center gap-1 sm:gap-1.5 px-2.5 sm:px-3 py-1.5 text-xs font-semibold font-mono text-slate-300 hover:text-white bg-[#070b16]/90 hover:bg-slate-800 border border-slate-800 hover:border-cyan-400/50 rounded-xl transition-all cursor-pointer active:scale-95">
      <span>⌨️</span>
      <span>Controls</span>
    </button>

    <button id="btn-splash-about" type="button" class="inline-flex items-center gap-1 sm:gap-1.5 px-2.5 sm:px-3 py-1.5 text-xs font-semibold font-mono text-slate-300 hover:text-white bg-[#070b16]/90 hover:bg-slate-800 border border-slate-800 hover:border-cyan-400/50 rounded-xl transition-all cursor-pointer active:scale-95">
      <span>ℹ️</span>
      <span>About</span>
    </button>
  </div>

</div>


<!-- SCREEN 2: MATCH SETUP & ARENA SELECT SCREEN (Revealed after clicking "PLAY!") -->
<div id="screen-setup" class="screen-view hidden-screen w-full h-full flex flex-col items-center justify-between px-3 py-2 sm:py-6 overflow-hidden select-none z-30">
  
  <!-- Setup Header with Back Button -->
  <div class="w-full max-w-xl flex items-center justify-between px-1 pt-1">
    <button
      id="btn-setup-back"
      type="button"
      class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono text-slate-300 hover:text-white bg-[#050814]/90 hover:bg-slate-800 border border-slate-800 rounded-full transition-all cursor-pointer active:scale-95"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span>TITLE SCREEN</span>
    </button>

    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#050814]/90 border border-slate-800 text-[10px] font-mono text-cyan-400">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
      <span>MATCH SETUP</span>
    </div>
  </div>

  <!-- Match Configuration Card -->
  <div class="w-full max-w-xl flex flex-col items-center justify-center my-auto overflow-y-auto max-h-[calc(100dvh-70px)] py-1">
    <div class="w-full nes-card rounded-2xl p-3.5 sm:p-6 border border-cyan-400/30 flex flex-col gap-3.5 sm:gap-4 shadow-[0_8px_32px_rgba(0,0,0,0.85)]">
      
      <!-- Section Title -->
      <div class="flex items-center justify-between border-b border-slate-800/80 pb-2">
        <div>
          <h2 class="text-sm sm:text-lg font-black text-white font-['Outfit'] tracking-wide">
            Select Battle Parameters
          </h2>
          <p class="text-[10px] sm:text-[11px] font-mono text-slate-400">Choose game mode, arena layout, and AI level.</p>
        </div>
        <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-cyan-950/40 border border-cyan-500/30 flex items-center justify-center shrink-0 shadow-[0_0_12px_rgba(0,229,255,0.15)]">
          <svg class="w-4 h-4 sm:w-5 sm:h-5 text-cyan-300" viewBox="0 0 24 24" fill="none">
            <polygon points="12 2 21 7.2 21 16.8 12 22 3 16.8 3 7.2" stroke="currentColor" stroke-width="1.8" fill="rgba(0,229,255,0.06)"/>
            <circle cx="8.5" cy="12" r="2.2" fill="#ff0844" stroke="#ffffff" stroke-width="0.8"/>
            <circle cx="15.5" cy="12" r="2.2" fill="#00e5ff" stroke="#ffffff" stroke-width="0.8"/>
          </svg>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3">
        <!-- Game Mode Selection -->
        <div class="flex flex-col gap-1">
          <label for="splash-select-mode" class="text-[10px] font-bold text-slate-400 font-['Outfit'] uppercase tracking-wider">
            Game Mode
          </label>
          <select
            id="splash-select-mode"
            class="w-full bg-[#04060c] border border-slate-700 hover:border-cyan-400 rounded-xl px-2.5 sm:px-3 py-1.5 sm:py-2 text-xs font-semibold text-slate-200 focus:outline-none focus:ring-1 focus:ring-cyan-400 transition-colors font-mono cursor-pointer"
          >
            <option value="pve" selected>VS Computer (1P)</option>
            <option value="pvp">2-Player Local (PvP)</option>
            <option value="trio">3-Player Arena (Trio)</option>
          </select>
        </div>

        <!-- Stage Arena Selection -->
        <div class="flex flex-col gap-1">
          <label for="splash-select-preset" class="text-[10px] font-bold text-slate-400 font-['Outfit'] uppercase tracking-wider">
            Battle Arena
          </label>
          <select
            id="splash-select-preset"
            class="w-full bg-[#04060c] border border-slate-700 hover:border-cyan-400 rounded-xl px-2.5 sm:px-3 py-1.5 sm:py-2 text-xs font-semibold text-slate-200 focus:outline-none focus:ring-1 focus:ring-cyan-400 transition-colors font-mono cursor-pointer"
          >
            <option value="classic" selected>Stage 1: Classic (58)</option>
            <option value="ring">Stage 2: Donut Void (48)</option>
            <option value="hourglass">Stage 3: Hourglass (40)</option>
            <option value="trio">Stage 4: Tri-Chamber (61)</option>
            <option value="warp">Stage 5: Warp Nexus (84)</option>
          </select>
        </div>
      </div>

      <!-- CPU Difficulty Buttons (Visible in PvE mode) -->
      <div id="splash-container-difficulty" class="flex flex-col gap-1">
        <span class="text-[10px] font-bold text-slate-400 font-['Outfit'] uppercase tracking-wider">
          AI Difficulty
        </span>
        <div class="grid grid-cols-3 gap-1 p-0.5 rounded-xl bg-[#04060c] border border-slate-700">
          <button type="button" data-diff="easy" class="btn-splash-diff py-1.5 sm:py-2 text-xs font-mono font-bold text-slate-400 rounded-lg transition-colors hover:text-emerald-300 cursor-pointer active:scale-95">Easy</button>
          <button type="button" data-diff="medium" class="btn-splash-diff active py-1.5 sm:py-2 text-xs font-mono font-bold text-cyan-200 bg-cyan-500/20 border border-cyan-400/80 rounded-lg cursor-pointer active:scale-95">Medium</button>
          <button type="button" data-diff="master" class="btn-splash-diff py-1.5 sm:py-2 text-xs font-mono font-bold text-slate-400 rounded-lg transition-colors hover:text-rose-400 cursor-pointer active:scale-95">Master</button>
        </div>
      </div>

      <!-- START BATTLE CTA BUTTON -->
      <button
        id="btn-splash-start-game"
        type="button"
        class="w-full mt-1 sm:mt-2 py-3 sm:py-3.5 px-6 rounded-xl font-bold font-['Outfit'] text-xs sm:text-sm tracking-wide text-black bg-gradient-to-r from-white via-cyan-100 to-cyan-300 hover:from-white hover:to-white shadow-[0_0_20px_rgba(0,229,255,0.4)] hover:shadow-[0_0_30px_rgba(0,229,255,0.7)] transition-all transform hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-2 cursor-pointer active:scale-[0.98]"
      >
        <svg class="w-4 h-4 sm:w-5 sm:h-5 text-black animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="text-xs sm:text-sm font-extrabold uppercase tracking-wider">START BATTLE</span>
      </button>

    </div>
  </div>

  <!-- Bottom Spacer -->
  <div class="h-1 sm:h-4"></div>

</div>

<!-- ==========================================================================
     HEXXAGON TACTICAL ANIMATED GAME CURSOR
     - Hardware-accelerated custom animated reticle + trailing aura
     - Reactive states: Default, Hover/Targeting, Click Impact
     - Disabled on touch screens (@media pointer: coarse) for 0 mobile overhead
     ========================================================================== -->

<div id="custom-cursor-container" class="fixed inset-0 pointer-events-none z-[9999] overflow-hidden select-none hidden md:block" aria-hidden="true">
  
  <!-- Smooth Trailing Energy Ring -->
  <div
    id="cursor-trailing-ring"
    class="fixed top-0 left-0 w-8 h-8 -ml-4 -mt-4 rounded-full border border-cyan-400/40 bg-cyan-500/10 shadow-[0_0_12px_rgba(0,229,255,0.4)] pointer-events-none transition-transform duration-75 ease-out opacity-0"
  ></div>

  <!-- Primary Precision Hex Reticle -->
  <div
    id="cursor-main-reticle"
    class="fixed top-0 left-0 w-7 h-7 -ml-3.5 -mt-3.5 pointer-events-none flex items-center justify-center opacity-0"
  >
    <svg viewBox="0 0 40 40" class="w-full h-full cursor-svg-element filter drop-shadow-[0_0_8px_rgba(0,229,255,0.8)]">
      <!-- Rotating Outer Hexagon Brackets -->
      <polygon
        id="cursor-hex-ring"
        points="20,2 35,11 35,29 20,38 5,29 5,11"
        fill="none"
        stroke="#00e5ff"
        stroke-width="2"
        stroke-dasharray="8 4"
        class="origin-center animate-[spin_8s_linear_infinite]"
      />
      
      <!-- Inner Glowing Crystal Orb -->
      <circle cx="20" cy="20" r="4.5" fill="url(#cursor-gem-grad)" stroke="#ffffff" stroke-width="1.2" />

      <!-- Center Crosshair Dot -->
      <circle cx="20" cy="20" r="1.5" fill="#ffffff" />

      <defs>
        <radialGradient id="cursor-gem-grad" cx="35%" cy="35%" r="65%">
          <stop offset="0%" stop-color="#ffffff"/>
          <stop offset="40%" stop-color="#00e5ff"/>
          <stop offset="80%" stop-color="#ff0844"/>
          <stop offset="100%" stop-color="#240008"/>
        </radialGradient>
      </defs>
    </svg>
  </div>

  <!-- Click Impact Particle Canvas -->
  <canvas id="cursor-click-canvas" class="fixed inset-0 w-full h-full pointer-events-none"></canvas>

</div>

<style>
  /* Custom Cursor Transitions & States */
  #cursor-main-reticle {
    transition: transform 0.08s cubic-bezier(0.2, 0, 0.2, 1), opacity 0.15s ease;
    will-change: transform, left, top;
  }

  #cursor-trailing-ring {
    transition: width 0.2s ease, height 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
    will-change: transform, left, top;
  }

  /* Hover State over interactive elements */
  body.cursor-is-hovering #cursor-main-reticle {
    transform: scale(1.35) rotate(15deg);
  }
  body.cursor-is-hovering #cursor-hex-ring {
    stroke: #ff2d60;
    stroke-width: 2.5;
    filter: drop-shadow(0 0 6px rgba(255, 45, 96, 0.8));
  }
  body.cursor-is-hovering #cursor-trailing-ring {
    width: 2.75rem;
    height: 2.75rem;
    margin-left: -1.375rem;
    margin-top: -1.375rem;
    border-color: rgba(255, 45, 96, 0.6);
    background-color: rgba(255, 45, 96, 0.12);
    box-shadow: 0 0 16px rgba(255, 45, 96, 0.5);
  }

  /* Active / Click Down State */
  body.cursor-is-down #cursor-main-reticle {
    transform: scale(0.75);
  }
  body.cursor-is-down #cursor-trailing-ring {
    transform: scale(0.6);
  }

  /* Hide custom cursor completely on coarse pointer touch devices */
  @media (pointer: coarse) {
    #custom-cursor-container {
      display: none !important;
    }
  }
</style>

<script>
  function initCustomCursor() {
    if (window.matchMedia('(pointer: coarse)').matches) return;

    const container = document.getElementById('custom-cursor-container');
    const reticle = document.getElementById('cursor-main-reticle');
    const trailingRing = document.getElementById('cursor-trailing-ring');
    const canvas = document.getElementById('cursor-click-canvas') as HTMLCanvasElement;
    if (!container || !reticle || !trailingRing || !canvas) return;

    const ctx = canvas.getContext('2d');
    let mouseX = -100, mouseY = -100;
    let trailX = -100, trailY = -100;
    let isVisible = false;
    let particles: Array<{ x: number; y: number; vx: number; vy: number; life: number; maxLife: number; color: string; size: number }> = [];

    function resizeCanvas() {
      if (canvas) {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      }
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas, { passive: true });

    // Track mouse coordinates
    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (!isVisible) {
        isVisible = true;
        reticle.style.opacity = '1';
        trailingRing.style.opacity = '1';
        trailX = mouseX;
        trailY = mouseY;
      }
    }, { passive: true });

    document.addEventListener('mouseleave', () => {
      isVisible = false;
      reticle.style.opacity = '0';
      trailingRing.style.opacity = '0';
    });

    document.addEventListener('mouseenter', () => {
      isVisible = true;
      reticle.style.opacity = '1';
      trailingRing.style.opacity = '1';
    });

    // Hover detection on interactive buttons / clickable elements
    document.addEventListener('mouseover', (e) => {
      const target = e.target as HTMLElement;
      if (!target) return;
      const isInteractive = target.closest('button, a, select, input, .hex-cell, .poki-btn, [role="button"], label, .clickable');
      if (isInteractive) {
        document.body.classList.add('cursor-is-hovering');
      } else {
        document.body.classList.remove('cursor-is-hovering');
      }
    }, { passive: true });

    // Click sparks & down state
    document.addEventListener('mousedown', (e) => {
      document.body.classList.add('cursor-is-down');
      spawnSparks(e.clientX, e.clientY);
    });

    document.addEventListener('mouseup', () => {
      document.body.classList.remove('cursor-is-down');
    });

    function spawnSparks(x: number, y: number) {
      const count = 8;
      const colors = ['#00e5ff', '#ff2d60', '#ffd000', '#ffffff'];
      for (let i = 0; i < count; i++) {
        const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.5;
        const speed = 2 + Math.random() * 3.5;
        particles.push({
          x,
          y,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          life: 0,
          maxLife: 16 + Math.random() * 8,
          color: colors[Math.floor(Math.random() * colors.length)],
          size: 2 + Math.random() * 2
        });
      }
    }

    // High performance 60fps render loop with lerping
    function render() {
      if (isVisible) {
        // Direct transform for reticle (zero lag)
        reticle.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;

        // Smooth lerp for trailing halo (juicy elastic lag)
        trailX += (mouseX - trailX) * 0.28;
        trailY += (mouseY - trailY) * 0.28;
        trailingRing.style.transform = `translate3d(${trailX}px, ${trailY}px, 0)`;
      }

      // Render click sparks
      if (ctx && particles.length > 0) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.x += p.vx;
          p.y += p.vy;
          p.vx *= 0.92;
          p.vy *= 0.92;
          p.life++;

          const progress = p.life / p.maxLife;
          const alpha = 1 - progress;

          ctx.fillStyle = p.color;
          ctx.globalAlpha = Math.max(0, alpha);
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size * (1 - progress * 0.5), 0, Math.PI * 2);
          ctx.fill();

          if (p.life >= p.maxLife) {
            particles.splice(i, 1);
          }
        }
        ctx.globalAlpha = 1;
      }

      requestAnimationFrame(render);
    }

    requestAnimationFrame(render);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCustomCursor);
  } else {
    initCustomCursor();
  }
</script>

  /* Theme 4: Tetris Matrix Grid & Stars */
  .bg-tetris-matrix-grid {
    background-image: 
      linear-gradient(to right, rgba(59, 130, 246, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(59, 130, 246, 0.06) 1px, transparent 1px);

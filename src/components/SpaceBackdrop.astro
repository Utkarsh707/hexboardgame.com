  }

  .bg-tetris-stars {
    background-image: 
      radial-gradient(1.5px 1.5px at 50px 60px, #06b6d4, rgba(0,0,0,0)),
      radial-gradient(1.5px 1.5px at 160px 190px, #ef4444, rgba(0,0,0,0)),
      radial-gradient(1px 1px at 280px 90px, #f59e0b, rgba(0,0,0,0)),
      radial-gradient(1.5px 1.5px at 410px 280px, #3b82f6, rgba(0,0,0,0)),
      radial-gradient(1.5px 1.5px at 540px 150px, #22c55e, rgba(0,0,0,0)),

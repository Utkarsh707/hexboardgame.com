<!-- ==========================================================================
     NES-INSPIRED VIDEOGAME SPACE STAGE BACKDROP
     - Classic 8-bit / 16-bit celestial backdrop with pixel stars & ringed gas giant
     - 100% hardware-accelerated CSS (0% JavaScript/Canvas CPU overhead)
     ========================================================================== -->
<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden select-none bg-[#03040a]">
  
  <!-- Retro Distant Ringed Planet (NES Gradius / Metroid Style) -->
  <div class="absolute top-[6%] right-[5%] sm:right-[10%] w-[160px] h-[160px] sm:w-[240px] sm:h-[240px] pointer-events-none opacity-80">
    <!-- Planetary Body -->
    <div class="relative w-full h-full rounded-full bg-gradient-to-tr from-[#1e1035] via-[#4c1d95] to-[#38bdf8] shadow-[0_0_50px_rgba(56,189,248,0.25)] overflow-hidden border border-cyan-400/20">
      <!-- Planet Surface Bands -->
      <div class="absolute inset-0 bg-planet-bands opacity-40"></div>
      <!-- Terminator Shadow -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-transparent to-transparent"></div>
    </div>
    <!-- Planetary Ring -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[160%] h-[35%] rounded-[50%] border-t-[6px] sm:border-t-[10px] border-b-[3px] border-cyan-300/60 shadow-[0_0_20px_rgba(56,189,248,0.4)] rotate-[-24deg]"></div>
  </div>

  <!-- Distant Crater Moon -->
  <div class="absolute top-[28%] left-[6%] sm:left-[12%] w-[50px] h-[50px] sm:w-[70px] sm:h-[70px] rounded-full bg-gradient-to-tr from-[#090d1a] via-[#1e293b] to-[#64748b] border border-slate-500/30 shadow-[0_0_20px_rgba(100,116,139,0.2)] opacity-70">
    <div class="absolute top-2 left-3 w-3 h-3 rounded-full bg-black/40 border border-slate-600/30"></div>
    <div class="absolute bottom-3 right-3 w-4 h-4 rounded-full bg-black/40 border border-slate-600/30"></div>
    <div class="absolute top-6 right-2 w-2 h-2 rounded-full bg-black/30"></div>
  </div>

  <!-- Layer 1: Chunky NES Pixel Stars (Twinkling) -->
  <div class="absolute inset-0 bg-nes-stars-1 animate-star-twinkle-1 opacity-90"></div>

  <!-- Layer 2: Colored Arcade Gem Stars (Cyan, Gold, Ruby) -->
  <div class="absolute inset-0 bg-nes-stars-2 animate-star-twinkle-2 opacity-85"></div>

  <!-- Layer 3: Distant Star Cluster Dust -->
  <div class="absolute inset-0 bg-nes-dust opacity-40"></div>

  <!-- Retro Space Station Horizon Truss Lines -->
  <div class="absolute bottom-0 inset-x-0 h-[120px] sm:h-[180px] pointer-events-none opacity-30">
    <div class="w-full h-full bg-retro-horizon [mask-image:linear-gradient(to_top,black_40%,transparent_100%)]"></div>
  </div>

  <!-- Subtle CRT Scanline overlay (Videogame Arcade Stage Vibe) -->
  <div class="absolute inset-0 bg-scanlines pointer-events-none opacity-20"></div>

</div>

<style>
  /* Planet Surface Striping */
  .bg-planet-bands {
    background: repeating-linear-gradient(
      -35deg,
      transparent,
      transparent 12px,
      rgba(236, 72, 153, 0.25) 12px,
      rgba(236, 72, 153, 0.25) 24px,
      transparent 24px,
      transparent 36px,
      rgba(56, 189, 248, 0.2) 36px,
      rgba(56, 189, 248, 0.2) 48px
    );
  }

  /* NES Pixel Starfield Layer 1: White & Silver Pixel Points */
  .bg-nes-stars-1 {
    background-image: 
      radial-gradient(2px 2px at 30px 40px, #ffffff, rgba(0,0,0,0)),
      radial-gradient(1.5px 1.5px at 120px 220px, #ffffff, rgba(0,0,0,0)),
      radial-gradient(3px 3px at 240px 90px, #ffffff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 380px 310px, #ffffff, rgba(0,0,0,0)),
      radial-gradient(1.5px 1.5px at 520px 160px, #ffffff, rgba(0,0,0,0)),
      radial-gradient(2.5px 2.5px at 670px 280px, #ffffff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 810px 70px, #ffffff, rgba(0,0,0,0)),
      radial-gradient(1.5px 1.5px at 940px 390px, #ffffff, rgba(0,0,0,0)),
      radial-gradient(3px 3px at 1080px 180px, #ffffff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 1240px 320px, #ffffff, rgba(0,0,0,0));
    background-repeat: repeat;
    background-size: 650px 450px;
  }

  /* NES Pixel Starfield Layer 2: Cyan & Ruby Arcade Diamonds */
  .bg-nes-stars-2 {
    background-image: 
      radial-gradient(2.5px 2.5px at 80px 150px, #00e5ff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 190px 340px, #ff2d60, rgba(0,0,0,0)),
      radial-gradient(3px 3px at 310px 40px, #facc15, rgba(0,0,0,0)),
      radial-gradient(2.5px 2.5px at 460px 250px, #00e5ff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 610px 110px, #a855f7, rgba(0,0,0,0)),
      radial-gradient(3px 3px at 760px 330px, #ff2d60, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 890px 210px, #facc15, rgba(0,0,0,0)),
      radial-gradient(2.5px 2.5px at 1020px 60px, #00e5ff, rgba(0,0,0,0)),
      radial-gradient(2px 2px at 1160px 290px, #ff2d60, rgba(0,0,0,0));
    background-repeat: repeat;
    background-size: 550px 380px;
  }

  /* Star Cluster Dust */
  .bg-nes-dust {
    background-image: 
      radial-gradient(1px 1px at 50px 80px, #e2e8f0, rgba(0,0,0,0)),
      radial-gradient(1px 1px at 160px 190px, #38bdf8, rgba(0,0,0,0)),
      radial-gradient(1px 1px at 290px 310px, #f43f5e, rgba(0,0,0,0)),
      radial-gradient(1px 1px at 430px 120px, #e2e8f0, rgba(0,0,0,0)),
      radial-gradient(1px 1px at 580px 270px, #38bdf8, rgba(0,0,0,0));
    background-repeat: repeat;
    background-size: 400px 300px;
  }

  /* Retro Horizon Grid */
  .bg-retro-horizon {
    background-size: 32px 32px;
    background-image: 
      linear-gradient(to right, rgba(0, 229, 255, 0.15) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 229, 255, 0.15) 1px, transparent 1px);
    transform: perspective(400px) rotateX(60deg);
    transform-origin: bottom center;
  }

  /* Subtle Arcade CRT Scanlines */
  .bg-scanlines {
    background: linear-gradient(
      to bottom,
      rgba(255,255,255,0),
      rgba(255,255,255,0) 50%,
      rgba(0, 0, 0, 0.4) 50%,
      rgba(0, 0, 0, 0.4)
    );
    background-size: 100% 4px;
  }

  @keyframes star-twinkle-1 {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 0.4; }
  }

  @keyframes star-twinkle-2 {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.9; }
  }

  .animate-star-twinkle-1 {
    animation: star-twinkle-1 3.5s infinite ease-in-out;
  }

  .animate-star-twinkle-2 {
    animation: star-twinkle-2 4.5s infinite ease-in-out;
  }
</style>

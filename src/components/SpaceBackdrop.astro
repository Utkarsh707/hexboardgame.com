     - Zero composite thrashing, 0% CPU overhead
     ========================================================================== -->
<div class="fixed inset-0 pointer-events-none z-0 overflow-hidden select-none bg-[#03040a]">
  
  <!-- Retro Distant Ringed Planet -->
  <div class="absolute top-[6%] right-[6%] sm:right-[12%] w-[140px] h-[140px] sm:w-[200px] sm:h-[200px] pointer-events-none opacity-75">
    <div class="relative w-full h-full rounded-full bg-gradient-to-tr from-[#160d29] via-[#3b1778] to-[#0284c7] shadow-[0_0_40px_rgba(2,132,199,0.2)] overflow-hidden border border-cyan-400/20">
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-transparent to-transparent"></div>
    </div>
    <!-- Planetary Ring -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[160%] h-[32%] rounded-[50%] border-t-[5px] sm:border-t-[8px] border-b-[2px] border-cyan-300/50 shadow-[0_0_15px_rgba(56,189,248,0.3)] rotate-[-24deg]"></div>
  </div>

  <!-- Distant Crater Moon -->
  <div class="absolute top-[26%] left-[6%] sm:left-[10%] w-[45px] h-[45px] sm:w-[60px] sm:h-[60px] rounded-full bg-gradient-to-tr from-[#090d1a] via-[#1e293b] to-[#475569] border border-slate-600/30 shadow-[0_0_15px_rgba(71,85,105,0.2)] opacity-60">
    <div class="absolute top-2 left-2.5 w-2.5 h-2.5 rounded-full bg-black/40 border border-slate-600/30"></div>
    <div class="absolute bottom-2.5 right-2.5 w-3.5 h-3.5 rounded-full bg-black/40 border border-slate-600/30"></div>
  </div>

  <!-- Layer 1: Crisp Static Pixel Starfield (Zero GPU Repaint overhead) -->
  <div class="absolute inset-0 bg-nes-stars-static opacity-90"></div>

  <!-- Layer 2: Subtle Ambient Star Dust Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_30%,rgba(255,45,96,0.06)_0%,transparent_50%),radial-gradient(circle_at_80%_70%,rgba(0,229,255,0.06)_0%,transparent_50%)] pointer-events-none"></div>

</div>


---

<!-- ==========================================================================
     4 HIGH-FIDELITY ARTISTIC GAME WORLD BACKDROPS
     1. Cosmic Odyssey (space_invaders) - Magical galaxy, ringed planet & cute retro UFO
     2. Fantasy Star Hills (kirby_mario)  - Whimsical rolling hills, fluffy clouds & smiling sun
     3. Cyber Metropolis (cyberpunk)       - Vibrant synthwave skyline & neon flying speeders
     4. Coral Reef Kingdom (tetris)        - Glowing fairy-tale jellyfish & magical coral castle
     ========================================================================== -->

<div id="stage-backdrop" class="fixed inset-0 pointer-events-none z-0 overflow-hidden select-none" data-theme="space_invaders">
  
  <!-- ========================================================================
       STAGE 1: COSMIC ODYSSEY (Magical Galaxy & UFO)
       ======================================================================== -->
  <div class="theme-layer theme-layer-cosmic absolute inset-0 pointer-events-none">
    <!-- Studio Digital Artwork -->
    <img
      src="/backgrounds/bg_cosmic_arena.jpg"
      alt="Cosmic Arena Galaxy Background"
      class="absolute inset-0 w-full h-full object-cover object-center transform scale-[1.02] filter brightness-90 contrast-105"
      loading="eager"
    />
    <!-- Center Board Contrast Vignette (Keeps the hex board crystal clear) -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(8,12,24,0.4)_0%,rgba(8,12,24,0.15)_45%,rgba(6,9,18,0.75)_100%)]"></div>
  </div>

  <!-- ========================================================================
       STAGE 2: FANTASY SUNSET STAR HILLS (Nintendo Mario/Kirby Inspired)
       ======================================================================== -->
  <div class="theme-layer theme-layer-sunset absolute inset-0 pointer-events-none">
    <!-- Studio Digital Artwork -->
    <img
      src="/backgrounds/bg_sunset_horizon.jpg"
      alt="Sunset Horizon Whimsical Hills Background"
      class="absolute inset-0 w-full h-full object-cover object-center transform scale-[1.02] filter brightness-90 contrast-105"
      loading="lazy"
    />
    <!-- Center Board Contrast Vignette -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(22,10,34,0.4)_0%,rgba(22,10,34,0.15)_45%,rgba(14,6,22,0.75)_100%)]"></div>
  </div>

  <!-- ========================================================================
       STAGE 3: CYBER METROPOLIS (Vibrant Neon Cityscape)
       ======================================================================== -->
  <div class="theme-layer theme-layer-cyber absolute inset-0 pointer-events-none">
    <!-- Studio Digital Artwork -->
    <img
      src="/backgrounds/bg_cyber_neon.jpg"
      alt="Cyber Neon Metropolis Skyline Background"
      class="absolute inset-0 w-full h-full object-cover object-center transform scale-[1.02] filter brightness-90 contrast-105"
      loading="lazy"
    />
    <!-- Center Board Contrast Vignette -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(10,4,22,0.4)_0%,rgba(10,4,22,0.15)_45%,rgba(6,2,14,0.78)_100%)]"></div>
  </div>

  <!-- ========================================================================
       STAGE 4: CORAL REEF KINGDOM (Fairy-tale Underwater Kingdom)
       ======================================================================== -->
  <div class="theme-layer theme-layer-ocean absolute inset-0 pointer-events-none">
    <!-- Studio Digital Artwork -->
    <img
      src="/backgrounds/bg_ocean_depths.jpg"
      alt="Coral Reef Kingdom Underwater Background"
      class="absolute inset-0 w-full h-full object-cover object-center transform scale-[1.02] filter brightness-90 contrast-105"
      loading="lazy"
    />
    <!-- Center Board Contrast Vignette -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(4,18,34,0.4)_0%,rgba(4,18,34,0.15)_45%,rgba(2,10,20,0.75)_100%)]"></div>
  </div>

</div>

<style>
  /* Zero-cost stage switching: show ONLY the active theme layer */
  .theme-layer {
    display: none !important;
    animation: fadeInBackdrop 0.4s ease-in-out forwards;
  }

  [data-theme="space_invaders"] .theme-layer-cosmic,
  #stage-backdrop[data-theme="space_invaders"] .theme-layer-cosmic {
    display: block !important;
  }

  [data-theme="kirby_mario"] .theme-layer-sunset,
  #stage-backdrop[data-theme="kirby_mario"] .theme-layer-sunset {
    display: block !important;
  }

  [data-theme="cyberpunk"] .theme-layer-cyber,
  #stage-backdrop[data-theme="cyberpunk"] .theme-layer-cyber {
    display: block !important;
  }

  [data-theme="tetris"] .theme-layer-ocean,
  #stage-backdrop[data-theme="tetris"] .theme-layer-ocean {
    display: block !important;
  }

  @keyframes fadeInBackdrop {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

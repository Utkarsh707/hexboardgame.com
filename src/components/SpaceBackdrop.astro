<!-- ==========================================================================
     AUTHENTIC GENRE-ACCURATE RETRO STAGE BACKDROPS
     - Stage 1: Space Invaders (1978 Arcade CRT • Pixel Aliens & Radar Oscilloscope)
     - Stage 2: 8-Bit Odyssey (Kirby & Mario NES • Pixel Hills, [?] Blocks & Nintendo Sky)
     - Stage 3: Cyberpunk 2099 (Synthwave Megacity Skyline, Neon Kanji & Horizon Grid)
     - Stage 4: Tetris Matrix (1989 Saint Basil's Cathedral Silhouette & Block Matrix)
     ========================================================================== -->
<div id="stage-backdrop" class="fixed inset-0 pointer-events-none z-0 overflow-hidden select-none" data-theme="space_invaders">
  
  <!-- ========================================================================
       STAGE 1: SPACE INVADERS (1978 Taito / Bally Midway Arcade CRT)
       ======================================================================== -->
  <div class="theme-layer theme-layer-space-invaders absolute inset-0 pointer-events-none bg-[#020704]">
    <!-- CRT Phosphor Radar Scanlines & Grid -->
    <div class="absolute inset-0 bg-space-crt-grid opacity-60"></div>
    <div class="absolute inset-0 bg-space-phosphor-dots opacity-80"></div>

    <!-- Arcade Header Score Readouts in Retro Vector Style -->
    <div class="absolute top-2 inset-x-0 flex justify-between px-4 sm:px-12 text-[9px] sm:text-[11px] font-mono text-[#00ff88]/60 font-bold uppercase tracking-widest pointer-events-none">
      <span>1P SCORE <span class="text-white">00420</span></span>
      <span class="hidden sm:inline">HIGH-SCORE <span class="text-[#ff007f]">99990</span></span>
      <span>2P SCORE <span class="text-white">00000</span></span>
    </div>

    <!-- Authentic 1978 Space Invader Pixel Formations (Vector SVGs) -->
    <svg class="absolute inset-0 w-full h-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Invader Crab Sprite Matrix (11x8) -->
        <pattern id="invader-crab-pattern" width="44" height="32" patternUnits="userSpaceOnUse">
          <g fill="#00ff88" opacity="0.45">
            <!-- Row 1 -->
            <rect x="8" y="0" width="4" height="4"/><rect x="32" y="0" width="4" height="4"/>
            <!-- Row 2 -->
            <rect x="12" y="4" width="4" height="4"/><rect x="28" y="4" width="4" height="4"/>
            <!-- Row 3 -->
            <rect x="8" y="8" width="28" height="4"/>
            <!-- Row 4 -->
            <rect x="4" y="12" width="8" height="4"/><rect x="16" y="12" width="12" height="4"/><rect x="32" y="12" width="8" height="4"/>
            <!-- Row 5 -->
            <rect x="0" y="16" width="44" height="4"/>
            <!-- Row 6 -->
            <rect x="0" y="20" width="4" height="4"/><rect x="8" y="20" width="28" height="4"/><rect x="40" y="20" width="4" height="4"/>
            <!-- Row 7 -->
            <rect x="0" y="24" width="4" height="4"/><rect x="8" y="24" width="4" height="4"/><rect x="32" y="24" width="4" height="4"/><rect x="40" y="24" width="4" height="4"/>
            <!-- Row 8 -->
            <rect x="12" y="28" width="8" height="4"/><rect x="24" y="28" width="8" height="4"/>
          </g>
        </pattern>

        <!-- Invader Squid Sprite Matrix (8x8) -->
        <g id="invader-squid" fill="#ff007f" opacity="0.4">
          <rect x="6" y="0" width="4" height="2"/>
          <rect x="4" y="2" width="8" height="2"/>
          <rect x="2" y="4" width="12" height="2"/>
          <rect x="0" y="6" width="4" height="2"/><rect x="6" y="6" width="4" height="2"/><rect x="12" y="6" width="4" height="2"/>
          <rect x="0" y="8" width="16" height="2"/>
          <rect x="4" y="10" width="2" height="2"/><rect x="10" y="10" width="2" height="2"/>
          <rect x="2" y="12" width="2" height="2"/><rect x="6" y="12" width="4" height="2"/><rect x="12" y="12" width="2" height="2"/>
          <rect x="0" y="14" width="2" height="2"/><rect x="14" y="14" width="2" height="2"/>
        </g>
      </defs>

      <!-- Flying Mystery Saucer (Top Bonus UFO) -->
      <g transform="translate(40, 48) scale(1.6)" fill="#ff0055" opacity="0.65">
        <rect x="10" y="0" width="12" height="2"/>
        <rect x="6" y="2" width="20" height="2"/>
        <rect x="4" y="4" width="24" height="2"/>
        <rect x="2" y="6" width="6" height="2"/><rect x="10" y="6" width="4" height="2"/><rect x="18" y="6" width="4" height="2"/><rect x="24" y="6" width="6" height="2"/>
        <rect x="0" y="8" width="32" height="2"/>
        <rect x="6" y="10" width="4" height="2"/><rect x="14" y="10" width="4" height="2"/><rect x="22" y="10" width="4" height="2"/>
        <rect x="8" y="12" width="2" height="2"/><rect x="22" y="12" width="2" height="2"/>
      </g>

      <!-- Squid Invader Flank Left -->
      <use href="#invader-squid" x="30" y="140" transform="scale(2.2)"/>
      <use href="#invader-squid" x="30" y="210" transform="scale(2.2)"/>

      <!-- Invader Crab Flank Right -->
      <g transform="translate(480, 120) scale(1.8)" fill="#00ff88" opacity="0.45">
        <rect x="8" y="0" width="4" height="4"/><rect x="32" y="0" width="4" height="4"/>
        <rect x="12" y="4" width="4" height="4"/><rect x="28" y="4" width="4" height="4"/>
        <rect x="8" y="8" width="28" height="4"/>
        <rect x="4" y="12" width="8" height="4"/><rect x="16" y="12" width="12" height="4"/><rect x="32" y="12" width="8" height="4"/>
        <rect x="0" y="16" width="44" height="4"/>
        <rect x="0" y="20" width="4" height="4"/><rect x="8" y="20" width="28" height="4"/><rect x="40" y="20" width="4" height="4"/>
        <rect x="0" y="24" width="4" height="4"/><rect x="8" y="24" width="4" height="4"/><rect x="32" y="24" width="4" height="4"/><rect x="40" y="24" width="4" height="4"/>
        <rect x="12" y="28" width="8" height="4"/><rect x="24" y="28" width="8" height="4"/>
      </g>

      <!-- Oscilloscope Radar Crosshairs in Bottom Right -->
      <circle cx="85%" cy="85%" r="65" fill="none" stroke="#00ff88" stroke-width="1.2" opacity="0.25" stroke-dasharray="6 4"/>
      <circle cx="85%" cy="85%" r="35" fill="none" stroke="#00ff88" stroke-width="1" opacity="0.3"/>
      <line x1="85%" y1="72%" x2="85%" y2="98%" stroke="#00ff88" stroke-width="1" opacity="0.25"/>
      <line x1="72%" y1="85%" x2="98%" y2="85%" stroke="#00ff88" stroke-width="1" opacity="0.25"/>
    </svg>

    <!-- Bottom Arcade Bunker Defenses (Pixel Green) -->
    <div class="absolute bottom-2 inset-x-0 flex justify-between px-6 sm:px-20 opacity-30 pointer-events-none">
      <div class="w-12 sm:w-16 h-8 bg-[#00ff88] rounded-t-lg [clip-path:polygon(0_0,100%_0,100%_100%,75%_100%,75%_40%,25%_40%,25%_100%,0_100%)]"></div>
      <div class="w-12 sm:w-16 h-8 bg-[#00ff88] rounded-t-lg [clip-path:polygon(0_0,100%_0,100%_100%,75%_100%,75%_40%,25%_40%,25%_100%,0_100%)]"></div>
    </div>
  </div>

  <!-- ========================================================================
       STAGE 2: 8-BIT ODYSSEY (Super Mario / Kirby NES 1985 Overworld)
       ======================================================================== -->
  <div class="theme-layer theme-layer-kirby-mario absolute inset-0 pointer-events-none bg-[#0e1633]">
    <!-- Nintendo 8-Bit Twilight Sunset Sky Gradient -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#182a5e] via-[#482b6b] to-[#783063] opacity-95"></div>

    <!-- Floating 8-Bit Question Mark [?] Coin Blocks & Brick Blocks -->
    <div class="absolute top-[10%] left-[6%] sm:left-[12%] flex items-center gap-1 opacity-70">
      <!-- Brick Block -->
      <div class="w-7 h-7 sm:w-9 sm:h-9 bg-[#c84c0c] border-2 border-black rounded-xs flex flex-col justify-between p-0.5 shadow-[2px_2px_0px_#000000]">
        <div class="w-full h-1 border-b border-black/60 bg-[#e45c10]"></div>
        <div class="w-full h-1 border-t border-black/60 bg-[#a03808]"></div>
      </div>
      <!-- Question Mark [?] Block -->
      <div class="w-7 h-7 sm:w-9 sm:h-9 bg-[#fcbc3c] border-2 border-black rounded-xs flex items-center justify-center font-mono font-black text-black text-xs sm:text-sm shadow-[2px_2px_0px_#000000] animate-bounce">
        ?
      </div>
      <!-- Brick Block -->
      <div class="w-7 h-7 sm:w-9 sm:h-9 bg-[#c84c0c] border-2 border-black rounded-xs flex flex-col justify-between p-0.5 shadow-[2px_2px_0px_#000000]">
        <div class="w-full h-1 border-b border-black/60 bg-[#e45c10]"></div>
        <div class="w-full h-1 border-t border-black/60 bg-[#a03808]"></div>
      </div>
    </div>

    <!-- Kirby Warp Star Moon in Top Right -->
    <div class="absolute top-[8%] right-[8%] sm:right-[14%] w-16 h-16 sm:w-20 sm:h-20 opacity-80 pointer-events-none">
      <svg viewBox="0 0 100 100" class="w-full h-full filter drop-shadow-[0_0_12px_rgba(254,240,138,0.6)]">
        <polygon points="50,5 64,36 98,36 70,57 81,90 50,70 19,90 30,57 2,36 36,36" fill="#fde047" stroke="#000000" stroke-width="4"/>
        <!-- Kirby Star Cheek Sparkle -->
        <circle cx="36" cy="48" r="4" fill="#ff69b4"/>
        <circle cx="64" cy="48" r="4" fill="#ff69b4"/>
      </svg>
    </div>

    <!-- Authentic 8-Bit Pixel Clouds -->
    <div class="absolute top-[22%] right-[5%] sm:right-[20%] opacity-45">
      <svg width="96" height="40" viewBox="0 0 96 40" fill="#ffffff">
        <rect x="24" y="0" width="48" height="8"/>
        <rect x="16" y="8" width="64" height="8"/>
        <rect x="8" y="16" width="80" height="8"/>
        <rect x="0" y="24" width="96" height="16"/>
        <!-- Eyes -->
        <rect x="40" y="24" width="4" height="8" fill="#000000"/>
        <rect x="52" y="24" width="4" height="8" fill="#000000"/>
      </svg>
    </div>

    <!-- Iconic Parallax 8-Bit NES Overworld Stepped Hills & Bushes at Bottom -->
    <div class="absolute bottom-0 inset-x-0 h-32 sm:h-44 pointer-events-none overflow-hidden opacity-60">
      <svg viewBox="0 0 1200 240" preserveAspectRatio="none" class="w-full h-full">
        <!-- Big Hill Left -->
        <polygon points="0,240 180,40 360,240" fill="#00a800" stroke="#000000" stroke-width="5"/>
        <circle cx="180" cy="90" r="16" fill="#80d010"/>
        <circle cx="150" cy="140" r="14" fill="#80d010"/>
        <circle cx="210" cy="140" r="14" fill="#80d010"/>

        <!-- Small Hill Center -->
        <polygon points="480,240 600,100 720,240" fill="#008800" stroke="#000000" stroke-width="4"/>
        <circle cx="600" cy="140" r="12" fill="#60b010"/>

        <!-- Big Hill Right -->
        <polygon points="840,240 1020,30 1200,240" fill="#00a800" stroke="#000000" stroke-width="5"/>
        <circle cx="1020" cy="80" r="16" fill="#80d010"/>
      </svg>
    </div>

    <!-- Candy Pastel Star Dust Layer -->
    <div class="absolute inset-0 bg-pastel-stars opacity-80"></div>
  </div>

  <!-- ========================================================================
       STAGE 3: CYBERPUNK 2099 (Megacity Skyline, Neon Kanji & Outrun Horizon)
       ======================================================================== -->
  <div class="theme-layer theme-layer-cyberpunk absolute inset-0 pointer-events-none bg-[#05010c]">
    <!-- Synthwave Sunset Deep Void -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#05010e] via-[#120326] to-[#250638]"></div>

    <!-- Sliced Retro Neon Synthwave Sun -->
    <div class="absolute top-[6%] left-1/2 -translate-x-1/2 w-[140px] h-[140px] sm:w-[190px] sm:h-[190px] pointer-events-none opacity-85">
      <div class="relative w-full h-full rounded-full bg-gradient-to-b from-[#ffea00] via-[#ff0055] to-[#7928ca] shadow-[0_0_40px_rgba(255,0,85,0.4)] overflow-hidden">
        <div class="absolute inset-0 bg-[repeating-linear-gradient(180deg,transparent_0px,transparent_6px,#05010c_6px,#05010c_9px,transparent_9px,transparent_18px,#05010c_18px,#05010c_22px)] opacity-90"></div>
      </div>
    </div>

    <!-- Floating Neon Japanese Kanji Holograms -->
    <div class="absolute top-[14%] left-[4%] sm:left-[10%] flex flex-col gap-1 items-center px-2 py-2 rounded-lg bg-black/60 border border-[#00f0ff]/50 shadow-[0_0_15px_rgba(0,240,255,0.3)] opacity-75">
      <span class="text-[12px] sm:text-[14px] font-black text-[#00f0ff] font-mono leading-tight tracking-wider">電脳</span>
      <span class="text-[8px] font-mono text-[#ff0055] font-bold">STAGE 03</span>
    </div>

    <div class="absolute top-[18%] right-[4%] sm:right-[12%] flex flex-col gap-1 items-center px-2 py-2 rounded-lg bg-black/60 border border-[#ff0055]/50 shadow-[0_0_15px_rgba(255,0,85,0.3)] opacity-75">
      <span class="text-[12px] sm:text-[14px] font-black text-[#ff0055] font-mono leading-tight tracking-wider">未来</span>
      <span class="text-[8px] font-mono text-[#00f0ff] font-bold">NEXUS</span>
    </div>

    <!-- Layered Cyberpunk Megacity Skyscraper Silhouettes with Illuminated Window Matrix -->
    <div class="absolute bottom-[18%] inset-x-0 h-40 sm:h-52 pointer-events-none opacity-70">
      <svg viewBox="0 0 1000 200" preserveAspectRatio="none" class="w-full h-full">
        <!-- Building 1 (Tower with Antenna) -->
        <rect x="30" y="40" width="70" height="160" fill="#0b0416" stroke="#00f0ff" stroke-width="0.8"/>
        <line x1="65" y1="10" x2="65" y2="40" stroke="#00f0ff" stroke-width="1.5"/>
        <circle cx="65" cy="10" r="2.5" fill="#ff0055"/>
        <!-- Window Matrix -->
        <g fill="#00f0ff" opacity="0.6">
          <rect x="42" y="55" width="4" height="4"/><rect x="52" y="55" width="4" height="4"/><rect x="74" y="55" width="4" height="4"/><rect x="84" y="55" width="4" height="4"/>
          <rect x="42" y="75" width="4" height="4"/><rect x="63" y="75" width="4" height="4"/><rect x="84" y="75" width="4" height="4"/>
          <rect x="52" y="95" width="4" height="4"/><rect x="74" y="95" width="4" height="4"/>
          <rect x="42" y="115" width="4" height="4"/><rect x="63" y="115" width="4" height="4"/><rect x="84" y="115" width="4" height="4"/>
        </g>

        <!-- Building 2 (Central Spire) -->
        <polygon points="180,200 180,60 215,20 250,60 250,200" fill="#080212" stroke="#ff0055" stroke-width="0.8"/>
        <g fill="#ff0055" opacity="0.6">
          <rect x="205" y="45" width="20" height="3"/><rect x="200" y="70" width="30" height="3"/><rect x="195" y="95" width="40" height="3"/>
          <rect x="195" y="120" width="40" height="3"/><rect x="195" y="145" width="40" height="3"/>
        </g>

        <!-- Building 3 (Right High-Rise) -->
        <rect x="750" y="30" width="90" height="170" fill="#0a0314" stroke="#00f0ff" stroke-width="0.8"/>
        <line x1="795" y1="5" x2="795" y2="30" stroke="#ff0055" stroke-width="1.5"/>
        <g fill="#00f0ff" opacity="0.5">
          <rect x="765" y="50" width="6" height="4"/><rect x="785" y="50" width="6" height="4"/><rect x="815" y="50" width="6" height="4"/>
          <rect x="765" y="70" width="6" height="4"/><rect x="800" y="70" width="6" height="4"/><rect x="815" y="70" width="6" height="4"/>
          <rect x="785" y="90" width="6" height="4"/><rect x="815" y="90" width="6" height="4"/>
        </g>

        <!-- Building 4 (Far Right Megatower) -->
        <rect x="890" y="50" width="80" height="150" fill="#07020e" stroke="#ff0055" stroke-width="0.8"/>
      </svg>
    </div>

    <!-- Outrun Perspective Road Grid at Bottom -->
    <div class="absolute bottom-0 inset-x-0 h-[22%] bg-synthwave-horizon-grid opacity-50"></div>
    <div class="absolute inset-0 bg-cyberpunk-stars opacity-85"></div>
  </div>

  <!-- ========================================================================
       STAGE 4: TETRIS MATRIX (1989 Saint Basil's Cathedral & Falling Matrix)
       ======================================================================== -->
  <div class="theme-layer theme-layer-tetris absolute inset-0 pointer-events-none bg-[#030614]">
    <!-- Cobalt Russian Arcade Matrix Background -->
    <div class="absolute inset-0 bg-gradient-to-b from-[#030718] via-[#081232] to-[#04091e]"></div>

    <!-- Arcade Top Score & Level Readout -->
    <div class="absolute top-2 inset-x-0 flex justify-between px-4 sm:px-12 text-[9px] sm:text-[11px] font-mono text-cyan-300/60 font-bold uppercase tracking-widest pointer-events-none">
      <span>LINES - <span class="text-white">040</span></span>
      <span class="text-[#f59e0b]">TETRIS 1989</span>
      <span>LEVEL <span class="text-white">09</span></span>
    </div>

    <!-- Authentic Saint Basil's Cathedral Architectural Silhouette (Iconic Tetris 1989 Title Artwork) -->
    <div class="absolute bottom-0 inset-x-0 h-44 sm:h-64 pointer-events-none opacity-50">
      <svg viewBox="0 0 1000 300" preserveAspectRatio="none" class="w-full h-full">
        <!-- Central Main Spire & Onion Dome (Saint Basil's) -->
        <g fill="#0b1638" stroke="#3b82f6" stroke-width="1.2">
          <!-- Central Onion Dome -->
          <path d="M 500,20 C 500,10 500,0 500,0 C 500,0 470,40 470,80 C 470,110 530,110 530,80 C 530,40 500,0 500,20 Z" fill="#122354"/>
          <rect x="480" y="105" width="40" height="70"/>
          <polygon points="460,175 540,175 560,300 440,300"/>

          <!-- Left Onion Dome (Flank Tower 1) -->
          <path d="M 360,70 C 360,55 360,45 360,45 C 360,45 335,80 335,110 C 335,135 385,135 385,110 C 385,80 360,45 360,70 Z" fill="#0e1d44"/>
          <rect x="345" y="130" width="30" height="60"/>
          <rect x="330" y="190" width="60" height="110"/>

          <!-- Far Left Dome (Flank Tower 2) -->
          <path d="M 220,110 C 220,95 220,85 220,85 C 220,85 200,115 200,140 C 200,160 240,160 240,140 C 240,115 220,85 220,110 Z" fill="#0a1533"/>
          <rect x="208" y="155" width="24" height="50"/>
          <rect x="195" y="205" width="50" height="95"/>

          <!-- Right Onion Dome (Flank Tower 1) -->
          <path d="M 640,70 C 640,55 640,45 640,45 C 640,45 615,80 615,110 C 615,135 665,135 665,110 C 665,80 640,45 640,70 Z" fill="#0e1d44"/>
          <rect x="625" y="130" width="30" height="60"/>
          <rect x="610" y="190" width="60" height="110"/>

          <!-- Far Right Dome (Flank Tower 2) -->
          <path d="M 780,110 C 780,95 780,85 780,85 C 780,85 760,115 760,140 C 760,160 800,160 800,140 C 800,115 780,85 780,110 Z" fill="#0a1533"/>
          <rect x="768" y="155" width="24" height="50"/>
          <rect x="755" y="205" width="50" height="95"/>
        </g>
      </svg>
    </div>

    <!-- Authentic Falling Tetromino Block Shapes -->
    <div class="absolute inset-0 pointer-events-none">
      <!-- Tetromino T (Purple) in Top Left -->
      <div class="absolute top-[14%] left-[6%] sm:left-[12%] flex flex-col items-center opacity-65 rotate-[15deg]">
        <div class="w-5 h-5 bg-[#a855f7] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#581c87]"></div>
        <div class="flex">
          <div class="w-5 h-5 bg-[#a855f7] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#581c87]"></div>
          <div class="w-5 h-5 bg-[#a855f7] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#581c87]"></div>
          <div class="w-5 h-5 bg-[#a855f7] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#581c87]"></div>
        </div>
      </div>

      <!-- Tetromino I (Cyan) in Top Right -->
      <div class="absolute top-[20%] right-[6%] sm:right-[14%] flex flex-col opacity-65 rotate-[-18deg]">
        <div class="w-5 h-5 bg-[#06b6d4] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#0e7490]"></div>
        <div class="w-5 h-5 bg-[#06b6d4] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#0e7490]"></div>
        <div class="w-5 h-5 bg-[#06b6d4] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#0e7490]"></div>
        <div class="w-5 h-5 bg-[#06b6d4] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#0e7490]"></div>
      </div>

      <!-- Tetromino Z (Red) in Bottom Left -->
      <div class="absolute bottom-[28%] left-[4%] sm:left-[10%] flex flex-col opacity-55 rotate-[24deg]">
        <div class="flex">
          <div class="w-5 h-5 bg-[#ef4444] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#7f1d1d]"></div>
          <div class="w-5 h-5 bg-[#ef4444] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#7f1d1d]"></div>
        </div>
        <div class="flex ml-5">
          <div class="w-5 h-5 bg-[#ef4444] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#7f1d1d]"></div>
          <div class="w-5 h-5 bg-[#ef4444] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#7f1d1d]"></div>
        </div>
      </div>

      <!-- Tetromino O (Yellow) in Bottom Right -->
      <div class="absolute bottom-[24%] right-[5%] sm:right-[12%] flex flex-col opacity-60 rotate-[-10deg]">
        <div class="flex">
          <div class="w-5 h-5 bg-[#f59e0b] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#78350f]"></div>
          <div class="w-5 h-5 bg-[#f59e0b] border-2 border-black shadow-[inset_1px_1px_0px_#ffffff,inset_-1px_-1px_0px_#78350f]"></div>
        </div>
        <div class="flex">

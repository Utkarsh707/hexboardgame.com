---
---

<dialog
  id="dialog-stats"
  class="fixed inset-0 z-50 p-3 sm:p-4 m-auto bg-transparent backdrop:bg-black/85 max-w-md w-[calc(100vw-1.5rem)]"
  aria-labelledby="stats-dialog-title"
>
  <div class="poki-card rounded-3xl p-5 sm:p-7 border-2 border-slate-700/60 text-slate-100 flex flex-col gap-4 max-h-[88vh] overflow-y-auto shadow-2xl">
    
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-slate-700/60 pb-3">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-2xl bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-base shadow-sm">
          📊
        </div>
        <h2 id="stats-dialog-title" class="text-base sm:text-lg font-black text-white tracking-wide font-['Outfit']">
          GAME STATS
        </h2>
      </div>
      <button
        id="btn-close-stats"
        type="button"
        class="p-2 text-slate-400 hover:text-white rounded-xl hover:bg-slate-800 transition-colors cursor-pointer"
        aria-label="Close statistics dialog"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 gap-2.5 text-center font-mono">
      <div class="p-3.5 rounded-2xl bg-[#0b1021] border border-slate-700/80 flex flex-col items-center">
        <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Total Matches</span>
        <span id="stat-total-games" class="text-2xl sm:text-3xl font-black text-white tabular-nums mt-0.5">0</span>
      </div>

      <div class="p-3.5 rounded-2xl bg-[#0b1021] border border-slate-700/80 flex flex-col items-center">
        <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Win Rate</span>
        <span id="stat-win-rate" class="text-2xl sm:text-3xl font-black text-emerald-400 tabular-nums mt-0.5">0%</span>
      </div>

      <div class="p-3.5 rounded-2xl bg-[#0b1021] border border-rose-500/40 flex flex-col items-center">
        <span class="text-[10px] uppercase font-bold tracking-wider text-[#ff2d60]">Ruby Wins</span>
        <span id="stat-ruby-wins" class="text-2xl sm:text-3xl font-black text-[#ff2d60] tabular-nums mt-0.5">0</span>
      </div>

      <div class="p-3.5 rounded-2xl bg-[#0b1021] border border-cyan-500/40 flex flex-col items-center">
        <span class="text-[10px] uppercase font-bold tracking-wider text-[#00e5ff]">Pearl Wins</span>
        <span id="stat-pearl-wins" class="text-2xl sm:text-3xl font-black text-[#00e5ff] tabular-nums mt-0.5">0</span>
      </div>
    </div>

    <!-- High Score telemetry -->
    <div class="p-3.5 rounded-2xl bg-[#0b1021] border border-slate-700/80 flex items-center justify-between text-xs font-mono text-slate-200">
      <span>Highest Ruby Score:</span>
      <strong id="stat-high-ruby" class="text-[#ff2d60] text-base tabular-nums font-black">0</strong>
    </div>

    <!-- Actions -->
    <div class="flex items-center justify-between pt-2 border-t border-slate-700/60">
      <button
        id="btn-reset-stats"
        type="button"
        class="text-xs text-rose-400 hover:text-rose-300 transition-colors font-mono font-bold cursor-pointer"
      >
        Clear Stats
      </button>

      <button
        id="btn-close-stats-action"
        type="button"
        class="poki-btn poki-btn-primary px-6 py-2.5 rounded-2xl text-xs font-black font-mono uppercase"
      >
        CLOSE
      </button>
    </div>

  </div>
</dialog>

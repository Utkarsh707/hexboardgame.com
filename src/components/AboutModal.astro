---
---

<dialog
  id="dialog-about"
  class="fixed inset-0 z-50 p-3 sm:p-4 m-auto bg-transparent backdrop:bg-black/85 max-w-md w-[calc(100vw-1.5rem)]"
  aria-labelledby="about-dialog-title"
>
  <div class="poki-card rounded-3xl p-5 sm:p-7 border-2 border-slate-700/60 text-slate-100 flex flex-col gap-4 max-h-[85vh] overflow-y-auto shadow-2xl">
    
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-slate-700/60 pb-3">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-2xl bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-base shadow-sm">
          ℹ️
        </div>
        <div>
          <span class="text-[10px] font-bold text-cyan-300 uppercase tracking-wider block font-['Outfit']">GAME HERITAGE</span>
          <h2 id="about-dialog-title" class="text-base sm:text-lg font-black text-white tracking-wide font-['Outfit']">
            About Hex Board Game
          </h2>
        </div>
      </div>
      <button
        id="btn-close-about"
        type="button"
        class="p-2 text-slate-400 hover:text-white rounded-xl hover:bg-slate-800 transition-colors cursor-pointer"
        aria-label="Close about dialog"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- About Content -->
    <div class="flex flex-col gap-3 text-xs leading-relaxed text-slate-200">
      <p>
        <strong class="text-white font-['Outfit'] text-sm">Online Hex Board Game</strong> is a modern recreation of the legendary 1993 board game <em>Hexxagon</em>, originally created by Software Creations.
      </p>
      
      <div class="p-3.5 rounded-2xl bg-[#0b1021] border border-slate-700/80 flex flex-col gap-2 text-xs text-slate-300">
        <span class="text-cyan-300 font-bold font-['Outfit']">Key Features:</span>
        <ul class="list-disc list-inside flex flex-col gap-1 text-slate-300">
          <li>Pure SVG Axial Vector Geometry & 60 FPS Game Engine</li>
          <li>Hardware-Accelerated Web Audio Engine</li>
          <li>Minimax AI with Alpha-Beta Pruning</li>
          <li>Interactive Step-by-Step Tutorial & Practice Arena</li>
        </ul>
      </div>

      <!-- Legal Links -->
      <div class="flex items-center justify-center gap-4 pt-2 text-xs text-slate-400">
        <a href={`${import.meta.env.BASE_URL}privacy-policy`} target="_blank" class="hover:text-cyan-300 underline underline-offset-2 transition-colors">Privacy Policy</a>
        <span>•</span>
        <a href={`${import.meta.env.BASE_URL}terms`} target="_blank" class="hover:text-cyan-300 underline underline-offset-2 transition-colors">Terms of Service</a>
      </div>

      <div class="text-center text-[10px] text-slate-500 pt-1">
        &copy; {new Date().getFullYear()} hexboardgame.com. All rights reserved.
      </div>
    </div>

    <!-- Footer Action -->
    <div class="flex justify-end pt-2 border-t border-slate-700/60">
      <button
        id="btn-confirm-about"
        type="button"
        class="poki-btn poki-btn-primary px-6 py-2.5 rounded-2xl text-xs font-black font-mono uppercase"
      >
        DISMISS
      </button>
    </div>

  </div>
</dialog>

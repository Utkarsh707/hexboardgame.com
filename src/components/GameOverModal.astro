<!-- ==========================================================================
     CRISP 8-BIT RETRO GAME OVER SCREEN
     - Zero blurry halos or translucent glassmorphic effects
     - High-contrast, sharp arcade typography & solid pixel aesthetics
     ========================================================================== -->

<dialog
  id="dialog-game-over"
  class="fixed inset-0 z-50 p-4 m-auto bg-transparent backdrop:bg-black/85 max-w-lg w-full border-none outline-none overflow-hidden select-none"
  aria-labelledby="game-over-title"
>
  <div class="w-full flex flex-col items-center text-center gap-6 py-6 font-['Press_Start_2P']">
    
    <!-- Sharp Retro Winner Icon -->
    <div id="game-over-icon" class="text-4xl sm:text-5xl animate-bounce">
      🏆
    </div>

    <!-- Crisp Winner Header -->
    <div class="flex flex-col items-center gap-3">
      <h2 id="game-over-title" class="text-xl sm:text-3xl text-white uppercase tracking-wider leading-tight">
        VICTORY!
      </h2>
      <p id="game-over-subtitle" class="text-[9px] sm:text-[10px] text-cyan-300 uppercase tracking-wide">
        HEX TERRITORY CLAIMED
      </p>
    </div>

    <!-- Sharp 8-Bit Score Duel -->
    <div class="flex items-center justify-center gap-8 sm:gap-12 py-3">
      <!-- Ruby Score -->
      <div class="flex flex-col items-center gap-2">
        <span class="text-[9px] sm:text-[10px] uppercase text-[#ff2d60] tracking-wider font-bold">
          RUBY
        </span>
        <span id="final-score-ruby" class="text-3xl sm:text-5xl font-black text-white">0</span>
      </div>

      <!-- Center Divider -->
      <div class="text-xs text-slate-500 uppercase tracking-widest px-2">
        VS
      </div>

      <!-- Pearl Score -->
      <div class="flex flex-col items-center gap-2">
        <span class="text-[9px] sm:text-[10px] uppercase text-[#00e5ff] tracking-wider font-bold">
          PEARL
        </span>
        <span id="final-score-pearl" class="text-3xl sm:text-5xl font-black text-white">0</span>
      </div>
    </div>

    <!-- Sharp Solid Retro Action Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 w-full max-w-sm pt-2">
      <!-- Replay Button -->
      <button
        id="btn-game-over-rematch"
        type="button"
        class="bouncy-play-btn w-full sm:w-auto px-6 py-3.5 rounded-xl bg-[#ff2d60] hover:bg-[#ff4b76] border-2 border-white text-white text-[10px] sm:text-xs uppercase flex items-center justify-center gap-2 shadow-[0_4px_0_#9f1239] transition-transform active:translate-y-1 active:shadow-none cursor-pointer font-['Press_Start_2P']"
      >
        <svg class="w-3.5 h-3.5 text-white shrink-0 fill-current" viewBox="0 0 24 24">
          <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
        <span>REPLAY</span>
      </button>

      <!-- Change Mode Button -->
      <button
        id="btn-game-over-mode"
        type="button"
        class="w-full sm:w-auto px-5 py-3.5 rounded-xl bg-[#141f3d] hover:bg-[#1e2d56] border-2 border-cyan-400 text-cyan-300 hover:text-white text-[10px] sm:text-xs uppercase flex items-center justify-center gap-2 shadow-[0_4px_0_#090e1f] transition-transform active:translate-y-1 active:shadow-none cursor-pointer font-['Press_Start_2P']"
      >
        <span>MODE</span>
      </button>
    </div>

    <!-- Review Board Link -->
    <button
      id="btn-game-over-close"
      type="button"
      class="text-[9px] text-slate-400 hover:text-cyan-300 uppercase tracking-wider underline underline-offset-4 transition-colors pt-2 cursor-pointer font-['Press_Start_2P']"
    >
      REVIEW BOARD
    </button>

  </div>
</dialog>

---
---

<dialog
  id="dialog-settings"
  class="fixed inset-0 z-50 p-3 sm:p-4 m-auto bg-transparent backdrop:bg-black/85 max-w-md w-[calc(100vw-1.5rem)]"
  aria-labelledby="settings-dialog-title"
>
  <div class="poki-card rounded-3xl p-5 sm:p-7 border-2 border-slate-700/60 text-slate-100 flex flex-col gap-4 max-h-[85vh] overflow-y-auto shadow-2xl">
    
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-slate-700/60 pb-3">
      <div class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-2xl bg-cyan-500/20 border border-cyan-400/50 flex items-center justify-center text-base shadow-sm">
          ⚙️
        </div>
        <div>
          <span class="text-[10px] font-bold text-cyan-300 uppercase tracking-wider block font-['Outfit']">GAME SETTINGS</span>
          <h2 id="settings-dialog-title" class="text-base sm:text-lg font-black text-white tracking-wide font-['Outfit']">
            Preferences & Audio
          </h2>
        </div>
      </div>
      <button
        id="btn-close-settings"
        type="button"
        class="p-2 text-slate-400 hover:text-white rounded-xl hover:bg-slate-800 transition-colors cursor-pointer"
        aria-label="Close settings dialog"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Settings Controls List -->
    <div class="flex flex-col gap-3 text-xs text-slate-200">

      <!-- Setting 0A: Board Theme -->
      <div class="flex flex-col gap-2 p-3.5 rounded-2xl bg-[#0b1021] border border-slate-700/80">
        <div class="flex items-center justify-between">
          <span class="font-bold text-white font-['Outfit'] text-xs sm:text-sm">Board Theme</span>
          <span class="text-[10px] text-cyan-300 font-mono">Visuals & BGM</span>
        </div>
        <select
          id="setting-select-theme"
          class="w-full bg-[#0d1429] border-2 border-slate-700 hover:border-cyan-400 rounded-xl px-3 py-2 text-xs font-bold text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-400 transition-colors font-mono cursor-pointer"
        >
          <option value="space_invaders">Cosmic Ruby & Pearl</option>
          <option value="kirby_mario">Sunset Horizon</option>
          <option value="cyberpunk">Cyber Neon</option>
          <option value="tetris">Ocean Depths</option>
        </select>
      </div>

      <!-- Setting 0B: Music Toggle -->
      <div class="flex items-center justify-between p-3.5 rounded-2xl bg-[#0b1021] border border-slate-700/80">
        <div class="flex flex-col">
          <span class="font-bold text-white font-['Outfit'] text-xs sm:text-sm">Background Music (BGM)</span>
          <span class="text-[10px] text-slate-400 font-mono">Interactive game music</span>
        </div>
        <button
          id="setting-toggle-music"
          type="button"
          class="poki-btn poki-btn-emerald px-3.5 py-1.5 rounded-xl text-xs font-mono font-bold"
        >
          ENABLED
        </button>
      </div>

      <!-- Setting 1: Sound Effects Toggle -->
      <div class="flex items-center justify-between p-3.5 rounded-2xl bg-[#0b1021] border border-slate-700/80">
        <div class="flex flex-col">
          <span class="font-bold text-white font-['Outfit'] text-xs sm:text-sm">Sound Effects (SFX)</span>
          <span class="text-[10px] text-slate-400 font-mono">Impact & move sound effects</span>
        </div>
        <button
          id="setting-toggle-sound"
          type="button"
          class="poki-btn poki-btn-emerald px-3.5 py-1.5 rounded-xl text-xs font-mono font-bold"
        >
          ENABLED
        </button>
      </div>

      <!-- Setting 2: Volume Slider -->
      <div class="flex flex-col gap-2 p-3.5 rounded-2xl bg-[#0b1021] border border-slate-700/80">
        <div class="flex items-center justify-between">
          <span class="font-bold text-white font-['Outfit'] text-xs sm:text-sm">Master Volume</span>
          <span id="setting-volume-label" class="text-xs font-mono font-bold text-cyan-300">70%</span>
        </div>
        <input
          id="setting-volume-slider"
          type="range"
          min="0"
          max="100"
          value="70"
          class="w-full accent-cyan-400 bg-slate-800 h-2 rounded-lg cursor-pointer"
        />
      </div>

      <!-- Setting 3: Screen Shake Toggle -->
      <div class="flex items-center justify-between p-3.5 rounded-2xl bg-[#0b1021] border border-slate-700/80">
        <div class="flex flex-col">
          <span class="font-bold text-white font-['Outfit'] text-xs sm:text-sm">Screen Shake FX</span>
          <span class="text-[10px] text-slate-400 font-mono">Dynamic capture vibration</span>
        </div>
        <button
          id="setting-toggle-shake"
          type="button"
          class="poki-btn poki-btn-emerald px-3.5 py-1.5 rounded-xl text-xs font-mono font-bold"
        >
          ENABLED
        </button>
      </div>

      <!-- Setting 4: Reduced Flashes Toggle -->
      <div class="flex items-center justify-between p-3.5 rounded-2xl bg-[#0b1021] border border-slate-700/80">
        <div class="flex flex-col">
          <span class="font-bold text-white font-['Outfit'] text-xs sm:text-sm">Comfort / Reduce Flashes</span>
          <span class="text-[10px] text-slate-400 font-mono">Softer particle effects</span>
        </div>
        <button
          id="setting-toggle-flashes"
          type="button"
          class="poki-btn poki-btn-secondary px-3.5 py-1.5 rounded-xl text-xs font-mono font-bold"
        >
          DISABLED
        </button>
      </div>

    </div>

    <!-- Actions -->
    <div class="flex items-center justify-between pt-2 border-t border-slate-700/60">
      <button
        id="btn-settings-clear-data"
        type="button"
        class="text-xs text-rose-400 hover:text-rose-300 transition-colors font-mono font-bold cursor-pointer"
      >
        Clear All Data
      </button>

      <button
        id="btn-confirm-settings"
        type="button"
        class="poki-btn poki-btn-primary px-6 py-2.5 rounded-2xl text-xs font-black font-mono uppercase"
      >
        DONE
      </button>
    </div>

  </div>
</dialog>

---
import Layout from '../layouts/Layout.astro';
import SplashScreen from '../components/SplashScreen.astro';
import GameOverModal from '../components/GameOverModal.astro';
import '../styles/global.css';
---

<Layout>
  
  <!-- 1. MINIMAL 8-BIT BOUNCY PLAY & SETUP SCREENS -->
  <SplashScreen />

  <!-- 2. ACTIVE GAME ARENA (Responsive layout: Top HUD Bar, Full-screen Center Board, Duel Score Bar) -->
  <div id="screen-game" class="screen-view hidden-screen w-full h-full relative flex flex-col justify-between items-center p-1 sm:p-3 md:p-6 overflow-hidden select-none">
    
    <!-- TOP BAR: NAVIGATION, LIVE TURN BANNER & QUICK ACTIONS -->
    <header class="w-full max-w-5xl flex items-center justify-between gap-2 px-2 pt-1 sm:px-4 sm:pt-2 shrink-0 z-40 font-['Press_Start_2P']">
      
      <!-- Back / Exit Match Button -->
      <button
        id="btn-game-back"
        type="button"
        class="inline-flex items-center gap-1.5 px-2.5 py-2 sm:px-3 sm:py-2 rounded-xl bg-[#090e1f]/85 hover:bg-[#141f3d] border border-slate-700/80 hover:border-cyan-400 text-slate-300 hover:text-white shadow-lg backdrop-blur-md text-[9px] sm:text-[10px] transition-all active:scale-95 cursor-pointer"
        title="Exit to Setup"
        aria-label="Exit Game"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span class="hidden sm:inline">EXIT</span>
      </button>

      <!-- Central Turn Status Banner -->
      <div id="turn-banner" class="flex items-center gap-2 px-3 py-1.5 sm:px-4 sm:py-2 rounded-2xl bg-[#090e1f]/90 border border-pink-500/50 text-pink-300 shadow-[0_0_15px_rgba(255,45,96,0.25)] backdrop-blur-md text-[9px] sm:text-[11px] transition-all">
        <span id="turn-banner-dot" class="w-2 h-2 rounded-full bg-[#ff0844] animate-ping"></span>
        <span id="turn-banner-text" class="tracking-wide">YOUR TURN</span>
      </div>

      <!-- Quick Action Controls (Undo + Restart + Audio Mute) -->
      <div class="flex items-center gap-1.5">
        <button
          id="btn-game-undo"
          type="button"
          class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#090e1f]/85 hover:bg-[#141f3d] border border-slate-700/80 hover:border-amber-400 text-slate-300 hover:text-amber-300 shadow-lg backdrop-blur-md flex items-center justify-center text-xs sm:text-sm transition-all active:scale-95 cursor-pointer"
          title="Undo Move (U)"
          aria-label="Undo Move"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M3 10h10a5 5 0 015 5v2m-15-7l4-4m-4 4l4 4" />
          </svg>
        </button>

        <button
          id="btn-restart-game"
          type="button"
          class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#090e1f]/85 hover:bg-[#141f3d] border border-slate-700/80 hover:border-cyan-400 text-slate-300 hover:text-white shadow-lg backdrop-blur-md flex items-center justify-center text-xs sm:text-sm transition-all active:scale-95 cursor-pointer"
          title="Restart Game (R)"
          aria-label="Restart Match"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        </button>

        <button
          id="btn-game-sound"
          type="button"
          class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-[#090e1f]/85 hover:bg-[#141f3d] border border-slate-700/80 hover:border-cyan-400 text-cyan-300 hover:text-white shadow-lg backdrop-blur-md flex items-center justify-center text-xs sm:text-sm transition-all active:scale-95 cursor-pointer"
          title="Toggle Audio (M)"
          aria-label="Toggle Sound"
        >
          <span id="game-sound-icon">🔊</span>
        </button>
      </div>

    </header>
    
    <!-- MAIN HERO HEXAGONAL BOARD (Maximized viewport that fills available space) -->
    <main id="game-main" class="relative w-full flex-1 min-h-0 flex items-center justify-center p-0.5 sm:p-2 my-auto">
      
      <!-- Board Viewport -->
      <div id="board-viewport" class="relative w-full h-full max-w-full md:max-w-7xl flex items-center justify-center">
        <!-- SVG Hexagon Board Grid -->
        <svg
          id="board-svg"
          viewBox="0 0 900 600"
          class="w-full h-full max-h-full select-none touch-manipulation z-10 filter drop-shadow-[0_8px_24px_rgba(0,0,0,0.5)]"
          aria-label="Hex Board Game Grid"
        ></svg>

        <!-- Dynamic Particle Canvas -->
        <canvas id="particle-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-30"></canvas>

        <!-- Combo Floating Floating Overlay -->
        <div id="combo-callout-overlay" class="absolute inset-0 pointer-events-none z-40 overflow-hidden"></div>
      </div>

    </main>

    <!-- BOTTOM: RESPONSIVE DUEL SCORECARD (Horizontal on mobile, vertical stack on desktop) -->
    <aside class="w-full max-w-md md:max-w-none md:w-auto md:absolute md:bottom-6 md:right-6 z-40 flex flex-col items-center md:items-end gap-2 pointer-events-auto font-['Press_Start_2P'] px-2 pb-1 sm:pb-2 md:p-0 shrink-0">
      
      <!-- Duel Score Card -->
      <div id="card-vertical-scoreboard" class="flex flex-row md:flex-col items-center justify-between md:justify-start gap-2 sm:gap-3 md:gap-1.5 p-2 sm:p-2.5 rounded-2xl bg-[#090e1f]/90 border border-slate-700/80 shadow-2xl backdrop-blur-md w-full md:w-auto">
        
        <!-- Player 1: Rubies -->
        <div id="card-player-ruby" class="flex items-center gap-2 px-2 py-1 rounded-xl transition-all border border-transparent">
          <div class="relative w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center shrink-0">
            <!-- 3D Ruby Sphere SVG -->
            <svg viewBox="0 0 100 100" class="w-full h-full filter drop-shadow-md">
              <ellipse cx="50" cy="85" rx="40" ry="12" fill="rgba(0,0,0,0.4)"></ellipse>
              <circle cx="50" cy="48" r="44" fill="url(#v-grad-ruby)" stroke="rgba(255,255,255,0.4)" stroke-width="2"></circle>
              <ellipse cx="36" cy="34" rx="18" ry="10" transform="rotate(-28 36 34)" fill="rgba(255,255,255,0.8)"></ellipse>
              <circle cx="30" cy="28" r="5" fill="#ffffff"></circle>
              <defs>
                <radialGradient id="v-grad-ruby" cx="30%" cy="26%" r="72%">
                  <stop offset="0%" stop-color="#ff7b96"/>
                  <stop offset="22%" stop-color="#ff0844"/>
                  <stop offset="60%" stop-color="#ba002c"/>
                  <stop offset="100%" stop-color="#240008"/>
                </radialGradient>
              </defs>
            </svg>
            <span id="turn-dot-ruby" class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-[#ff0844] ring-2 ring-black animate-ping"></span>
            <span id="turn-dot-ruby-solid" class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-[#ff0844] ring-2 ring-black"></span>
          </div>
          <div class="flex flex-col md:flex-row md:items-center gap-0.5 md:gap-2">
            <span class="text-[7px] sm:text-[8px] text-pink-300 md:hidden">RUBY</span>
            <span id="score-ruby" class="score-number text-xs sm:text-sm font-black text-white leading-none min-w-[1.4rem] text-left md:text-right">3</span>
          </div>
        </div>

        <!-- Duel Tug-of-War Bar (Mobile Visible) / Subtle Divider (Desktop) -->
        <div class="flex-1 md:hidden flex flex-col items-center gap-1 px-1">
          <div class="w-full h-2 rounded-full bg-slate-800 border border-slate-700 overflow-hidden flex">
            <div id="duel-bar-ruby" class="h-full bg-gradient-to-r from-[#ff0844] to-[#ff2d60] transition-all duration-300" style="width: 50%;"></div>
            <div id="duel-bar-pearl" class="h-full bg-gradient-to-r from-[#00e5ff] to-[#38bdf8] transition-all duration-300" style="width: 50%;"></div>
          </div>
          <span id="duel-score-summary" class="text-[7px] text-slate-400 font-mono tracking-tighter">50% - 50%</span>
        </div>
        <div class="hidden md:block h-px w-full bg-slate-700/60"></div>

        <!-- Player 2 / AI: Pearls -->
        <div id="card-player-pearl" class="flex items-center gap-2 px-2 py-1 rounded-xl transition-all border border-transparent">
          <div class="flex flex-col md:flex-row md:items-center gap-0.5 md:gap-2 text-right">
            <span class="text-[7px] sm:text-[8px] text-cyan-300 md:hidden">PEARL</span>
            <span id="score-pearl" class="score-number text-xs sm:text-sm font-black text-white leading-none min-w-[1.4rem] text-right">3</span>
          </div>
          <div class="relative w-6 h-6 sm:w-7 sm:h-7 rounded-full flex items-center justify-center shrink-0">
            <!-- 3D Pearl Sphere SVG -->
            <svg viewBox="0 0 100 100" class="w-full h-full filter drop-shadow-md">
              <ellipse cx="50" cy="85" rx="40" ry="12" fill="rgba(0,0,0,0.4)"></ellipse>
              <circle cx="50" cy="48" r="44" fill="url(#v-grad-pearl)" stroke="rgba(255,255,255,0.5)" stroke-width="2"></circle>
              <ellipse cx="36" cy="34" rx="18" ry="10" transform="rotate(-28 36 34)" fill="rgba(255,255,255,0.9)"></ellipse>
              <circle cx="30" cy="28" r="5" fill="#ffffff"></circle>
              <defs>
                <radialGradient id="v-grad-pearl" cx="30%" cy="26%" r="72%">
                  <stop offset="0%" stop-color="#ffffff"/>
                  <stop offset="25%" stop-color="#e0f2fe"/>
                  <stop offset="60%" stop-color="#7dd3fc"/>
                  <stop offset="85%" stop-color="#0284c7"/>
                  <stop offset="100%" stop-color="#082f49"/>
                </radialGradient>
              </defs>
            </svg>
            <span id="turn-dot-pearl" class="hidden absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-[#00e5ff] ring-2 ring-black animate-ping"></span>
            <span id="turn-dot-pearl-solid" class="hidden absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-[#00e5ff] ring-2 ring-black"></span>
          </div>
        </div>

      </div>

    </aside>

  </div>

  <!-- GAME OVER MODAL (8-Bit Free-Floating Overlay) -->
  <GameOverModal />

</Layout>

<script>
  import { initGameUI } from '../scripts/game-ui.js';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGameUI);
  } else {
    initGameUI();
  }
</script>

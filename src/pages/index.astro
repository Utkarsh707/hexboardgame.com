---
import Layout from '../layouts/Layout.astro';
import SplashScreen from '../components/SplashScreen.astro';
import GameOverModal from '../components/GameOverModal.astro';
import '../styles/global.css';
---

<Layout>
  
  <!-- 1. MINIMAL BOUNCY PLAY SPLASH SCREEN (Initial view) -->
  <SplashScreen />

  <!-- 2. ACTIVE GAME ARENA (Board dominates screen, zero HUD, vertical score tally at bottom-right) -->
  <div id="screen-game" class="screen-view hidden-screen w-full h-full relative flex items-center justify-center p-2 sm:p-4 md:p-6 overflow-hidden select-none">
    
    <!-- MAIN HERO HEXAGONAL BOARD (Maximizes viewport size) -->
    <main id="game-main" class="relative w-full h-full max-w-[min(94vw,94vh,760px)] max-h-[min(94vw,94vh,760px)] aspect-square flex items-center justify-center my-auto">
      
      <!-- 1:1 Frameless Board Viewport -->
      <div id="board-viewport" class="relative w-full h-full aspect-square flex items-center justify-center">
        <!-- SVG Hexagon Board Grid -->
        <svg
          id="board-svg"
          viewBox="0 0 700 700"
          class="absolute inset-0 w-full h-full select-none touch-manipulation z-10"
          aria-label="Hex Board Game Grid"
        ></svg>

        <!-- Dynamic Particle Canvas -->
        <canvas id="particle-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-30"></canvas>

        <!-- Combo Floating Floating Overlay -->
        <div id="combo-callout-overlay" class="absolute inset-0 pointer-events-none z-40 overflow-hidden"></div>
      </div>

    </main>

    <!-- BOTTOM RIGHT: VERTICAL SCORE TALLY STACK & AUDIO CONTROLS -->
    <aside class="absolute bottom-3 right-3 sm:bottom-6 sm:right-6 z-40 flex flex-col items-end gap-2 pointer-events-auto">
      
      <!-- Vertical Score Stack Card -->
      <div id="card-vertical-scoreboard" class="flex flex-col gap-1.5 p-2 sm:p-2.5 rounded-2xl bg-[#090e1f]/85 border border-slate-700/80 shadow-2xl backdrop-blur-md">
        
        <!-- Player 1: Rubies -->
        <div id="card-player-ruby" class="flex items-center gap-2 px-2 py-1 rounded-xl transition-all border border-transparent">
          <div class="relative w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center shrink-0">
            <!-- 3D Ruby Sphere SVG -->
            <svg viewBox="0 0 100 100" class="w-full h-full filter drop-shadow-md">
              <ellipse cx="50" cy="85" rx="40" ry="12" fill="rgba(0,0,0,0.4)"></ellipse>
              <circle cx="50" cy="48" r="44" fill="url(#v-grad-ruby)" stroke="rgba(255,255,255,0.4)" stroke-width="2"></circle>
              <ellipse cx="36" cy="34" rx="18" ry="10" transform="rotate(-28 36 34)" fill="rgba(255,255,255,0.8)"></ellipse>
              <circle cx="30" cy="28" r="5" fill="#ffffff"></circle>
              <defs>
                <radialGradient id="v-grad-ruby" cx="30%" cy="26%" r="72%">
                  <stop offset="0%" stop-color="#ff7b96"/>
                  <stop offset="22%" stop-color="#ff0844"/>
                  <stop offset="60%" stop-color="#ba002c"/>
                  <stop offset="100%" stop-color="#240008"/>
                </radialGradient>
              </defs>
            </svg>
            <span id="turn-dot-ruby" class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-[#ff0844] ring-2 ring-black animate-ping"></span>
            <span id="turn-dot-ruby-solid" class="absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-[#ff0844] ring-2 ring-black"></span>
          </div>
          <span id="score-ruby" class="score-number text-lg sm:text-2xl font-black font-mono text-white leading-none min-w-[1.4rem] text-right">3</span>
        </div>

        <!-- Subtle Divider -->
        <div class="h-px w-full bg-slate-700/60"></div>

        <!-- Player 2 / AI: Pearls -->
        <div id="card-player-pearl" class="flex items-center gap-2 px-2 py-1 rounded-xl transition-all border border-transparent">
          <div class="relative w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center shrink-0">
            <!-- 3D Pearl Sphere SVG -->
            <svg viewBox="0 0 100 100" class="w-full h-full filter drop-shadow-md">
              <ellipse cx="50" cy="85" rx="40" ry="12" fill="rgba(0,0,0,0.4)"></ellipse>
              <circle cx="50" cy="48" r="44" fill="url(#v-grad-pearl)" stroke="rgba(255,255,255,0.5)" stroke-width="2"></circle>
              <ellipse cx="36" cy="34" rx="18" ry="10" transform="rotate(-28 36 34)" fill="rgba(255,255,255,0.9)"></ellipse>
              <circle cx="30" cy="28" r="5" fill="#ffffff"></circle>
              <defs>
                <radialGradient id="v-grad-pearl" cx="30%" cy="26%" r="72%">
                  <stop offset="0%" stop-color="#ffffff"/>
                  <stop offset="25%" stop-color="#e0f2fe"/>
                  <stop offset="60%" stop-color="#7dd3fc"/>
                  <stop offset="85%" stop-color="#0284c7"/>
                  <stop offset="100%" stop-color="#082f49"/>
                </radialGradient>
              </defs>
            </svg>
            <span id="turn-dot-pearl" class="hidden absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-[#00e5ff] ring-2 ring-black animate-ping"></span>
            <span id="turn-dot-pearl-solid" class="hidden absolute -top-0.5 -right-0.5 w-2 h-2 rounded-full bg-[#00e5ff] ring-2 ring-black"></span>
          </div>
          <span id="score-pearl" class="score-number text-lg sm:text-2xl font-black font-mono text-white leading-none min-w-[1.4rem] text-right">3</span>
        </div>

      </div>

      <!-- In-Game Quick Action Pill (Sound Mute + Restart) -->
      <div class="flex items-center gap-1.5">
        <button
          id="btn-restart-game"
          type="button"
          class="w-9 h-9 rounded-full bg-[#090e1f]/85 hover:bg-[#141f3d] border border-slate-700/80 hover:border-cyan-400 text-slate-300 hover:text-white shadow-lg backdrop-blur-md flex items-center justify-center text-sm transition-all active:scale-95 cursor-pointer"
          title="Restart Game"
          aria-label="Restart Match"
        >
          <svg class="w-4 h-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        </button>

        <button
          id="btn-game-sound"
          type="button"
          class="w-9 h-9 rounded-full bg-[#090e1f]/85 hover:bg-[#141f3d] border border-slate-700/80 hover:border-cyan-400 text-cyan-300 hover:text-white shadow-lg backdrop-blur-md flex items-center justify-center text-sm transition-all active:scale-95 cursor-pointer"
          title="Toggle Audio"
          aria-label="Toggle Sound"
        >
          <span id="game-sound-icon">🔊</span>
        </button>
      </div>

    </aside>

  </div>

  <!-- GAME OVER MODAL (Clean rematch prompt) -->
  <GameOverModal />

</Layout>

<script>
  import { initGameUI } from '../scripts/game-ui.js';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGameUI);
  } else {
    initGameUI();
  }
</script>

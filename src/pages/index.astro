---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HowToPlayModal from '../components/HowToPlayModal.astro';
import StatsModal from '../components/StatsModal.astro';
import KeyboardShortcutsModal from '../components/KeyboardShortcutsModal.astro';
import GameOverModal from '../components/GameOverModal.astro';
import RulesSection from '../components/RulesSection.astro';
import StrategyGuide from '../components/StrategyGuide.astro';
import AdSlot from '../components/AdSlot.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout>
  <!-- Header Navigation -->
  <Header />

  <!-- MAIN GAME ARENA (Authentic Hexxagon Aesthetic) -->
  <main id="game-main" class="w-full max-w-5xl mx-auto px-3 sm:px-6 flex flex-col items-center justify-start py-3 sm:py-6">
    
    <!-- TOP SCOREBOARD & TURN HEADER (Unified Desktop & Mobile) -->
    <div class="w-full max-w-2xl flex items-center justify-between gap-2 sm:gap-4 px-3 sm:px-5 py-2.5 sm:py-3.5 rounded-2xl bg-[#090c14] border border-slate-800/80 shadow-[0_4px_20px_rgba(0,0,0,0.5)] mb-3 sm:mb-5">
      
      <!-- Player 1: Rubies -->
      <div id="card-player-ruby" class="flex items-center gap-2.5 sm:gap-3.5 px-3 py-1.5 rounded-xl border border-transparent transition-all duration-300">
        <!-- 3D Ruby Sphere Icon -->
        <div class="relative w-9 h-9 sm:w-11 sm:h-11 rounded-full flex items-center justify-center shrink-0">
          <svg viewBox="0 0 100 100" class="w-full h-full">
            <ellipse cx="50" cy="85" rx="40" ry="12" fill="rgba(0,0,0,0.5)"></ellipse>
            <circle cx="50" cy="48" r="44" fill="url(#grad-ruby-hud)" stroke="rgba(255,255,255,0.4)" stroke-width="2"></circle>
            <ellipse cx="36" cy="34" rx="18" ry="10" transform="rotate(-28 36 34)" fill="rgba(255,255,255,0.75)"></ellipse>
            <circle cx="30" cy="28" r="5" fill="#ffffff"></circle>
            <defs>
              <radialGradient id="grad-ruby-hud" cx="30%" cy="26%" r="72%">
                <stop offset="0%" stop-color="#ff7b96"/>
                <stop offset="22%" stop-color="#ff0844"/>
                <stop offset="60%" stop-color="#ba002c"/>
                <stop offset="100%" stop-color="#240008"/>
              </radialGradient>
            </defs>
          </svg>
          <span id="turn-dot-ruby" class="absolute -top-0.5 -right-0.5 w-3 h-3 rounded-full bg-[#ff0844] ring-2 ring-black animate-ping"></span>
          <span id="turn-dot-ruby-solid" class="absolute -top-0.5 -right-0.5 w-3 h-3 rounded-full bg-[#ff0844] ring-2 ring-black"></span>
        </div>
        <div class="flex flex-col">
          <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-[#ff4b72] font-['Outfit']">Rubies</span>
          <span id="score-ruby" class="text-2xl sm:text-4xl font-black font-mono text-white leading-none tracking-tight">3</span>
        </div>
      </div>

      <!-- Center Status & Turn Pill -->
      <div class="flex flex-col items-center gap-1.5 shrink-0">
        <div id="turn-status-badge" class="inline-flex items-center gap-2 px-3 sm:px-4 py-1 sm:py-1.5 rounded-full text-xs font-mono font-bold bg-[#04060c] border border-slate-700/80 text-cyan-200 shadow-inner">
          <span id="turn-status-indicator" class="w-2.5 h-2.5 rounded-full bg-[#ff0844] shadow-[0_0_8px_#ff0844]"></span>
          <span id="turn-status-text" class="uppercase tracking-wider text-[10px] sm:text-xs font-['Outfit'] font-bold">Your Turn</span>
        </div>
        
        <div class="flex items-center gap-2">
          <button
            id="btn-hud-undo"
            type="button"
            class="inline-flex items-center gap-1 text-[10px] sm:text-[11px] font-mono text-slate-400 hover:text-white bg-slate-800/80 hover:bg-slate-700 px-2 py-0.5 rounded-md transition-colors border border-slate-700"
            title="Undo Last Move"
          >
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
            </svg>
            <span>Undo</span>
          </button>
          <span class="text-[10px] font-mono text-slate-500">Move <strong id="hud-move-count" class="text-slate-300">0</strong></span>
        </div>
      </div>

      <!-- Player 2 / AI: Pearls -->
      <div id="card-player-pearl" class="flex items-center gap-2.5 sm:gap-3.5 px-3 py-1.5 rounded-xl border border-transparent transition-all duration-300 text-right">
        <div class="flex flex-col items-end">
          <span id="label-player-pearl" class="text-[10px] sm:text-xs font-bold uppercase tracking-wider text-cyan-300 font-['Outfit']">Pearls</span>
          <span id="score-pearl" class="text-2xl sm:text-4xl font-black font-mono text-white leading-none tracking-tight">3</span>
        </div>
        <!-- 3D Pearl Sphere Icon -->
        <div class="relative w-9 h-9 sm:w-11 sm:h-11 rounded-full flex items-center justify-center shrink-0">
          <svg viewBox="0 0 100 100" class="w-full h-full">
            <ellipse cx="50" cy="85" rx="40" ry="12" fill="rgba(0,0,0,0.5)"></ellipse>
            <circle cx="50" cy="48" r="44" fill="url(#grad-pearl-hud)" stroke="rgba(255,255,255,0.5)" stroke-width="2"></circle>
            <ellipse cx="36" cy="34" rx="18" ry="10" transform="rotate(-28 36 34)" fill="rgba(255,255,255,0.85)"></ellipse>
            <circle cx="30" cy="28" r="5" fill="#ffffff"></circle>
            <defs>
              <radialGradient id="grad-pearl-hud" cx="30%" cy="26%" r="72%">
                <stop offset="0%" stop-color="#ffffff"/>
                <stop offset="25%" stop-color="#f2f7fc"/>
                <stop offset="60%" stop-color="#c5d1d9"/>
                <stop offset="85%" stop-color="#607d8b"/>
                <stop offset="100%" stop-color="#263238"/>
              </radialGradient>
            </defs>
          </svg>
          <span id="turn-dot-pearl" class="hidden absolute -top-0.5 -right-0.5 w-3 h-3 rounded-full bg-[#00e5ff] ring-2 ring-black animate-ping"></span>
          <span id="turn-dot-pearl-solid" class="hidden absolute -top-0.5 -right-0.5 w-3 h-3 rounded-full bg-[#00e5ff] ring-2 ring-black"></span>
        </div>
      </div>

    </div>

    <!-- 3-PLAYER (EMERALD) SCORE CARD (Hidden in 2P, Shown in 3P) -->
    <div id="card-player-emerald" class="hidden w-full max-w-2xl items-center justify-between px-4 py-2 rounded-xl bg-[#090c14] border border-emerald-500/30 mb-3">
      <div class="flex items-center gap-3">
        <span class="text-xl">🟢</span>
        <span class="text-xs font-bold text-emerald-400 font-['Outfit']">Emeralds (Player 3)</span>
      </div>
      <span id="score-emerald" class="text-2xl font-black font-mono text-emerald-400">2</span>
    </div>

    <!-- THE HERO HEXAGONAL BOARD (Centered, Responsive, Full View) -->
    <div class="relative w-full aspect-square max-w-[min(100vw-1.5rem,540px)] flex items-center justify-center p-1 sm:p-2">
      
      <!-- Ambient Outer Glow (Zero-blur radial gradient) -->
      <div class="absolute inset-0 rounded-[2.5rem] bg-[radial-gradient(circle_at_center,rgba(0,229,255,0.06)_0%,transparent_70%)] pointer-events-none"></div>

      <!-- Hexxagon Glass Board Platform -->
      <div class="relative w-full h-full rounded-3xl bg-[#070910] border border-slate-800/80 shadow-[0_8px_32px_rgba(0,0,0,0.7)] flex items-center justify-center p-2 sm:p-4 overflow-hidden">
        
        <!-- Subtle Grid Floor Light -->
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(30,41,59,0.3)_0%,transparent_70%)] pointer-events-none"></div>

        <!-- SVG Hexagon Board -->
        <svg
          id="board-svg"
          viewBox="0 0 700 700"
          class="w-full h-full relative z-10 select-none touch-manipulation"
          aria-label="Hexxagon Board Game Grid"
        ></svg>

        <!-- Dynamic Particle Canvas -->
        <canvas id="particle-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-30"></canvas>

        <!-- Arcade Combo Floating Badge Overlay -->
        <div id="combo-callout-overlay" class="absolute inset-0 pointer-events-none z-40 overflow-hidden"></div>

      </div>
    </div>

    <!-- ACTION LEGEND (Clone vs Jump vs Infect) -->
    <div class="w-full max-w-md grid grid-cols-3 gap-2 my-3 px-3 py-2 rounded-xl bg-[#080b12] border border-slate-800/70 text-[11px] font-['Outfit'] text-slate-300 text-center shadow-md">
      <div class="flex items-center justify-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-[#00e676] shadow-[0_0_6px_#00e676] shrink-0"></span>
        <span><strong>1 Step:</strong> Clone</span>
      </div>
      <div class="flex items-center justify-center gap-1.5 border-x border-slate-800 px-1">
        <span class="w-2.5 h-2.5 rounded-full bg-[#ffab00] shadow-[0_0_6px_#ffab00] shrink-0"></span>
        <span><strong>2 Steps:</strong> Jump</span>
      </div>
      <div class="flex items-center justify-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-[#ff0844] shadow-[0_0_6px_#ff0844] shrink-0"></span>
        <span><strong>Adjacent:</strong> Infect</span>
      </div>
    </div>

    <!-- GAME CONTROLS & STAGE CONFIGURATION BAR -->
    <div class="w-full max-w-2xl grid grid-cols-1 sm:grid-cols-3 gap-2.5 p-3 rounded-2xl bg-[#090c14] border border-slate-800/80 shadow-lg mt-1">
      
      <!-- Match Type Selector -->
      <div class="flex flex-col gap-1">
        <label for="select-game-mode" class="text-[10px] font-bold text-slate-400 font-['Outfit'] uppercase tracking-wider">
          Game Mode
        </label>
        <select
          id="select-game-mode"
          class="w-full bg-[#04060c] border border-slate-700 hover:border-cyan-400 rounded-xl px-2.5 py-2 text-xs font-medium text-slate-200 focus:outline-none focus:ring-1 focus:ring-cyan-400 transition-colors font-mono"
        >
          <option value="pve" selected>🤖 VS Computer</option>
          <option value="pvp">👥 2-Player Local</option>
          <option value="trio">⚔️ 3-Player Arena</option>
        </select>
      </div>

      <!-- Stage Preset Selector -->
      <div class="flex flex-col gap-1">
        <label for="select-board-preset" class="text-[10px] font-bold text-slate-400 font-['Outfit'] uppercase tracking-wider">
          Stage Arena
        </label>
        <select
          id="select-board-preset"
          class="w-full bg-[#04060c] border border-slate-700 hover:border-cyan-400 rounded-xl px-2.5 py-2 text-xs font-medium text-slate-200 focus:outline-none focus:ring-1 focus:ring-cyan-400 transition-colors font-mono"
        >
          <option value="classic" selected>Stage 1: Classic (58)</option>
          <option value="ring">Stage 2: Donut Void (48)</option>
          <option value="hourglass">Stage 3: Hourglass (40)</option>
          <option value="trio">Stage 4: Tri-Chamber (61)</option>
        </select>
      </div>

      <!-- CPU Difficulty Buttons -->
      <div id="container-ai-difficulty" class="flex flex-col gap-1">
        <div class="flex items-center justify-between">
          <span class="text-[10px] font-bold text-slate-400 font-['Outfit'] uppercase tracking-wider">Difficulty</span>
          <span id="diff-lock-badge" class="hidden text-[9px] font-mono text-amber-400 bg-amber-500/10 px-1 rounded">🔒 Locked</span>
        </div>
        <div class="grid grid-cols-3 gap-1 p-0.5 rounded-xl bg-[#04060c] border border-slate-700">
          <button type="button" data-diff="easy" class="btn-difficulty py-1.5 text-xs font-mono font-bold text-slate-400 rounded-lg transition-colors hover:text-emerald-300">Easy</button>
          <button type="button" data-diff="medium" class="btn-difficulty active py-1.5 text-xs font-mono font-bold text-cyan-200 bg-cyan-500/20 border border-cyan-400/80 rounded-lg">Med</button>
          <button type="button" data-diff="master" class="btn-difficulty py-1.5 text-xs font-mono font-bold text-slate-400 rounded-lg transition-colors hover:text-rose-400">Master</button>
        </div>
      </div>

    </div>

    <!-- Non-Intrusive Auto-Collapsing Google Ad Container -->
    <AdSlot className="mt-4" />

    <!-- Collapsible Rules & Strategy Guides -->
    <div class="w-full max-w-3xl flex flex-col gap-3 mt-4">
      <RulesSection />
      <StrategyGuide />
    </div>

  </main>

  <!-- Modals -->
  <HowToPlayModal />
  <StatsModal />
  <KeyboardShortcutsModal />
  <GameOverModal />

  <!-- Footer -->
  <Footer />
</Layout>

<script>
  import { initGameUI } from '../scripts/game-ui.js';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGameUI);
  } else {
    initGameUI();
  }
</script>

---
import Layout from '../layouts/Layout.astro';
import SplashScreen from '../components/SplashScreen.astro';
import Header from '../components/Header.astro';
import HowToPlayModal from '../components/HowToPlayModal.astro';
import StrategyModal from '../components/StrategyModal.astro';
import SettingsModal from '../components/SettingsModal.astro';
import StatsModal from '../components/StatsModal.astro';
import KeyboardShortcutsModal from '../components/KeyboardShortcutsModal.astro';
import AboutModal from '../components/AboutModal.astro';
import GameOverModal from '../components/GameOverModal.astro';
import '../styles/global.css';
---

<Layout>
  
  <!-- 1. SPLASH / TITLE SCREEN (Active by default on initial URL visit) -->
  <SplashScreen />

  <!-- 2. ACTIVE GAME ARENA SCREEN (Zero-Scroll Viewport Container) -->
  <div id="screen-game" class="screen-view hidden-screen w-full h-full flex flex-col items-center justify-between overflow-hidden">
    
    <!-- Arena Header Navigation -->
    <Header />

    <!-- MAIN GAME ARENA (Centered, Responsive, Zero-Scroll) -->
    <main id="game-main" class="flex-1 w-full max-w-4xl mx-auto px-2 sm:px-4 flex flex-col items-center justify-between py-1.5 sm:py-2.5 min-h-0 overflow-hidden">
      
      <!-- TOP SCOREBOARD & TURN HEADER -->
      <div class="w-full max-w-xl flex items-center justify-between gap-2 px-3 py-1.5 sm:py-2 rounded-2xl bg-[#090c14] border border-slate-800/80 shadow-[0_4px_20px_rgba(0,0,0,0.5)] shrink-0">
        
        <!-- Player 1: Rubies -->
        <div id="card-player-ruby" class="flex items-center gap-2 sm:gap-3 px-2.5 py-1 rounded-xl border border-transparent transition-all duration-300">
          <!-- 3D Ruby Sphere Icon -->
          <div class="relative w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center shrink-0">
            <svg viewBox="0 0 100 100" class="w-full h-full">
              <ellipse cx="50" cy="85" rx="40" ry="12" fill="rgba(0,0,0,0.5)"></ellipse>
              <circle cx="50" cy="48" r="44" fill="url(#grad-ruby-hud)" stroke="rgba(255,255,255,0.4)" stroke-width="2"></circle>
              <ellipse cx="36" cy="34" rx="18" ry="10" transform="rotate(-28 36 34)" fill="rgba(255,255,255,0.75)"></ellipse>
              <circle cx="30" cy="28" r="5" fill="#ffffff"></circle>
              <defs>
                <radialGradient id="grad-ruby-hud" cx="30%" cy="26%" r="72%">
                  <stop offset="0%" stop-color="#ff7b96"/>
                  <stop offset="22%" stop-color="#ff0844"/>
                  <stop offset="60%" stop-color="#ba002c"/>
                  <stop offset="100%" stop-color="#240008"/>
                </radialGradient>
              </defs>
            </svg>
            <span id="turn-dot-ruby" class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-[#ff0844] ring-2 ring-black animate-ping"></span>
            <span id="turn-dot-ruby-solid" class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-[#ff0844] ring-2 ring-black"></span>
          </div>
          <div class="flex flex-col">
            <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-[#ff4b72] font-['Outfit']">Rubies</span>
            <span id="score-ruby" class="text-xl sm:text-3xl font-black font-mono text-white leading-none tracking-tight">3</span>
          </div>
        </div>

        <!-- Center Status & Turn Pill -->
        <div class="flex flex-col items-center gap-1 shrink-0">
          <div id="turn-status-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-bold bg-[#04060c] border border-slate-700/80 text-cyan-200 shadow-inner">
            <span id="turn-status-indicator" class="w-2 h-2 rounded-full bg-[#ff0844] shadow-[0_0_8px_#ff0844]"></span>
            <span id="turn-status-text" class="uppercase tracking-wider text-[10px] sm:text-[11px] font-['Outfit'] font-bold">Your Turn</span>
          </div>
          
          <div class="flex items-center gap-2">
            <button
              id="btn-hud-undo"
              type="button"
              class="inline-flex items-center gap-1 text-[10px] font-mono text-slate-400 hover:text-white bg-slate-800/80 hover:bg-slate-700 px-2 py-0.5 rounded-md transition-colors border border-slate-700 cursor-pointer"
              title="Undo Last Move"
            >
              <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
              </svg>
              <span>Undo</span>
            </button>
            <span class="text-[10px] font-mono text-slate-500">Move <strong id="hud-move-count" class="text-slate-300">0</strong></span>
          </div>
        </div>

        <!-- Player 2 / AI: Pearls -->
        <div id="card-player-pearl" class="flex items-center gap-2 sm:gap-3 px-2.5 py-1 rounded-xl border border-transparent transition-all duration-300 text-right">
          <div class="flex flex-col items-end">
            <span id="label-player-pearl" class="text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-cyan-300 font-['Outfit']">Pearls</span>
            <span id="score-pearl" class="text-xl sm:text-3xl font-black font-mono text-white leading-none tracking-tight">3</span>
          </div>
          <!-- 3D Pearl Sphere Icon -->
          <div class="relative w-8 h-8 sm:w-10 sm:h-10 rounded-full flex items-center justify-center shrink-0">
            <svg viewBox="0 0 100 100" class="w-full h-full">
              <ellipse cx="50" cy="85" rx="40" ry="12" fill="rgba(0,0,0,0.5)"></ellipse>
              <circle cx="50" cy="48" r="44" fill="url(#grad-pearl-hud)" stroke="rgba(255,255,255,0.5)" stroke-width="2"></circle>
              <ellipse cx="36" cy="34" rx="18" ry="10" transform="rotate(-28 36 34)" fill="rgba(255,255,255,0.85)"></ellipse>
              <circle cx="30" cy="28" r="5" fill="#ffffff"></circle>
              <defs>
                <radialGradient id="grad-pearl-hud" cx="30%" cy="26%" r="72%">
                  <stop offset="0%" stop-color="#ffffff"/>
                  <stop offset="25%" stop-color="#f2f7fc"/>
                  <stop offset="60%" stop-color="#c5d1d9"/>
                  <stop offset="85%" stop-color="#607d8b"/>
                  <stop offset="100%" stop-color="#263238"/>
                </radialGradient>
              </defs>
            </svg>
            <span id="turn-dot-pearl" class="hidden absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-[#00e5ff] ring-2 ring-black animate-ping"></span>
            <span id="turn-dot-pearl-solid" class="hidden absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-[#00e5ff] ring-2 ring-black"></span>
          </div>
        </div>

      </div>

      <!-- 3-PLAYER (EMERALD) SCORE CARD (Hidden in 2P, Shown in 3P) -->
      <div id="card-player-emerald" class="hidden w-full max-w-xl items-center justify-between px-3 py-1.5 rounded-xl bg-[#090c14] border border-emerald-500/30 shrink-0">
        <div class="flex items-center gap-2">
          <span class="text-base">🟢</span>
          <span class="text-xs font-bold text-emerald-400 font-['Outfit']">Emeralds (Player 3)</span>
        </div>
        <span id="score-emerald" class="text-xl font-black font-mono text-emerald-400">2</span>
      </div>

      <!-- THE HERO FLOATING HEXAGONAL ARENA (Frameless Organic Arena, Zero Scroll) -->
      <div class="relative w-full aspect-square max-h-[min(510px,calc(100dvh-145px))] flex items-center justify-center min-h-0 my-auto">
        
        <!-- Ambient Arena Energy Aura (Floating radial light centered on the hex honeycomb) -->
        <div class="absolute inset-0 rounded-full bg-[radial-gradient(circle_at_center,rgba(0,229,255,0.08)_0%,rgba(255,45,96,0.04)_40%,transparent_70%)] pointer-events-none"></div>

        <!-- 1:1 Frameless Board Viewport (SVG & Overlay stacked directly on the celestial canvas) -->
        <div id="board-viewport" class="relative w-full h-full aspect-square flex items-center justify-center">
          <!-- SVG Hexagon Board -->
          <svg
            id="board-svg"
            viewBox="0 0 700 700"
            class="absolute inset-0 w-full h-full select-none touch-manipulation z-10 [filter:drop-shadow(0_12px_32px_rgba(0,0,0,0.85))]"
            aria-label="Hexxagon Board Game Grid"
          ></svg>

          <!-- Dynamic Particle Canvas -->
          <canvas id="particle-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-30"></canvas>

          <!-- Arcade Combo Floating Badge Overlay -->
          <div id="combo-callout-overlay" class="absolute inset-0 pointer-events-none z-40 overflow-hidden"></div>
        </div>

      </div>

      <!-- ACTION LEGEND BAR (Clone vs Jump vs Infect + Stage info) -->
      <div class="w-full max-w-lg flex items-center justify-between gap-2 px-3 py-1.5 rounded-xl bg-[#080b12] border border-slate-800/70 text-[10px] sm:text-[11px] font-['Outfit'] text-slate-300 shadow-md shrink-0">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-[#00e676] shadow-[0_0_6px_#00e676] shrink-0"></span>
          <span><strong>1-Step:</strong> Clone</span>
        </div>
        <div class="flex items-center gap-1.5 border-x border-slate-800 px-2">
          <span class="w-2 h-2 rounded-full bg-[#ffab00] shadow-[0_0_6px_#ffab00] shrink-0"></span>
          <span><strong>2-Step:</strong> Jump</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-[#ff0844] shadow-[0_0_6px_#ff0844] shrink-0"></span>
          <span><strong>Touch:</strong> Infect</span>
        </div>
        <div class="border-l border-slate-800 pl-2 text-slate-500 font-mono text-[10px] hidden xs:block">
          <span id="stage-banner-text">Stage 1</span>
        </div>
      </div>

    </main>

  </div>

  <!-- POP-UP MODAL SCREENS (Accessible Dialogs) -->
  <HowToPlayModal />
  <StrategyModal />
  <SettingsModal />
  <StatsModal />
  <KeyboardShortcutsModal />
  <AboutModal />
  <GameOverModal />

</Layout>

<script>
  import { initGameUI } from '../scripts/game-ui.js';
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGameUI);
  } else {
    initGameUI();
  }
</script>

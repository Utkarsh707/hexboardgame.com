---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Terms of Service | Online Hex Board Game (hexboardgame.com)"
  description="Terms of service and usage conditions for Online Hex Board Game (hexboardgame.com)."
>
  <Header />

  <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-10 sm:py-16 text-slate-300">
    <div class="nes-card rounded-2xl p-6 sm:p-10 border border-cyan-400/30 flex flex-col gap-6">
      
      <div class="border-b border-cyan-500/20 pb-4">
        <span class="text-[9px] font-['Press_Start_2P'] text-cyan-300">LEGAL & USAGE</span>
        <h1 class="text-2xl sm:text-3xl font-bold text-white font-['Outfit'] mt-1">
          Terms of Service
        </h1>
        <p class="text-xs text-slate-400 font-mono mt-1">
          Last Updated: August 2026
        </p>
      </div>

      <div class="flex flex-col gap-5 text-xs sm:text-sm leading-relaxed text-slate-300 font-sans">
        <section class="flex flex-col gap-2">
          <h2 class="text-base font-bold text-white font-['Outfit']">1. Acceptance of Terms</h2>
          <p>
            By accessing and playing games on <strong>hexboardgame.com</strong>, you agree to be bound by these Terms of Service. If you do not agree with any part of these terms, you may discontinue use of the website at any time.
          </p>
        </section>

        <section class="flex flex-col gap-2">
          <h2 class="text-base font-bold text-white font-['Outfit']">2. Permitted Use</h2>
          <p>
            Online Hex Board Game is provided for free personal entertainment and educational use. Automated scraping, reverse engineering with malicious intent, or denial of service attacks against this platform are strictly prohibited.
          </p>
        </section>

        <section class="flex flex-col gap-2">
          <h2 class="text-base font-bold text-white font-['Outfit']">3. Intellectual Property</h2>
          <p>
            The game code, animations, interface designs, sound synthesizer algorithms, and custom styling on <strong>hexboardgame.com</strong> are proprietary property. Hexxagon is an intellectual homage inspired by classic 1993 hexagonal strategy games.
          </p>
        </section>

        <section class="flex flex-col gap-2">
          <h2 class="text-base font-bold text-white font-['Outfit']">4. Disclaimer of Warranties</h2>
          <p>
            This website is provided "as is" without warranties of any kind, whether express or implied. We do not guarantee uninterrupted or error-free gameplay.
          </p>
        </section>

        <section class="flex flex-col gap-2">
          <h2 class="text-base font-bold text-white font-['Outfit']">5. Contact Information</h2>
          <p>
            For legal inquiries or questions regarding these terms, please contact: <span class="font-mono text-cyan-300">support@hexboardgame.com</span>.
          </p>
        </section>
      </div>

      <div class="pt-4 border-t border-cyan-500/20">
        <a href="/" class="nes-btn-primary inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-mono font-bold">
          ← Return to Game
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
